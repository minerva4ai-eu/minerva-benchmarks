ENVIRONMENT=/leonardo_work/MNRVA_bench/minerva-benchmarks/inference/inference-LEONARDO/env_vllm

# SINGULARITY CONTAINERS
VLLM_IMAGE=/leonardo_work/MNRVA_bench/vllm-0.21.0-cuda-compat.sif
