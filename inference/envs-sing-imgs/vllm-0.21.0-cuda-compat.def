Bootstrap: docker
From: vllm/vllm-openai:v0.21.0

%environment
  export LC_ALL=C.UTF-8
  export LANG=C.UTF-8
  export VLLM_ENABLE_CUDA_COMPATIBILITY=1
  export VLLM_CUDA_COMPATIBILITY_PATH="/usr/local/cuda-13.0/compat"
  export LD_LIBRARY_PATH=/usr/local/cuda-13.0/compat:$LD_LIBRARY_PATH
  export TRITON_PTXAS_PATH=/usr/local/cuda-13.0/compat/ptxas

%post
  # 1. Install minimal system dependencies
  apt-get update && apt-get install -y --no-install-recommends --allow-change-held-packages \
    python3-pip python3-dev git curl build-essential libnccl2 libnccl-dev

  # 
  apt-get install -y --no-install-recommends cuda-compat-13.0

  # 2. install uv env tool
  pip install --upgrade pip
  pip install datasets
