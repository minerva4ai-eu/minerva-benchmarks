INFO 09-15 16:13:48 [logger.py:43] Received request cmpl-ea9799206be94922a21de7bf18e4931d-0: prompt: 'it worked, can you do the same thing for the gen command, make it encode before decoding.\n@bot.command()\nasync def gen(ctx, item: str):\n with open("saved.json", "r") as f:\n data = json.load(f)\n server\\_id = str(ctx.guild.id)\n if server\\_id not in data:\n await ctx.send("This server hasn\'t run the setup command yet.")\n return\n if ctx.channel.id != int(data[server\\_id]["gen\\_channel"]):\n await ctx.send("The gen command can only be used in the designated gen channel.")\n return\n if not any(role.id == int(data[server\\_id]["gen\\_role"]) for role in ctx.author.roles):\n await ctx.send("Sorry, you can\'t gen since you don\'t have the gen role.")\n return\n file\\_path = os.path.join("C:\\\\Users\\\\xcybe\\\\Downloads\\\\Gen Bot\\\\Stock\\\\{}\\\\Added Stock\\\\{}".format(server\\_id, item))\n if not os.path.exists(file\\_path):\n await ctx.send("This item doesn\'t exist in the stock.")\n return\n with open(file\\_path, "r") as f:\n lines = f.readlines()\n if len(lines) == 0:\n await ctx.send("Sorry, this item is out of stock.")\n return\n with open(file\\_path, "w") as f:\n f.writelines(lines[1:])\n deleted\\_file\\_path = os.path.join("C:\\\\Users\\\\xcybe\\\\Downloads\\\\Gen Bot\\\\Stock\\\\{}\\\\Deleted Stock\\\\{} Deleted.txt".format(server\\_id, item))\n if not os.path.exists(deleted\\_file\\_path):\n with open(deleted\\_file\\_path, "w") as f:\n pass\n with open(deleted\\_file\\_path, "a") as f:\n f.write(lines[0].strip() + "\\n")\n await ctx.author.send(lines[0].strip())\n await ctx.send("I sent it to your DMs.")\n\n log\\_channel\\_id = int(data[server\\_id]["log\\_channel"])\n log\\_channel = ctx.guild.get\\_channel(log\\_channel\\_id)\n time = datetime.datetime.now().strftime("%m/%d/%Y %H:%M:%S")\n await log\\_channel.send(f"{ctx.author} generated {item} at {time}.")', params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repet