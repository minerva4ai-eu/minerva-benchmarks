INFO 09-15 16:14:20 [logger.py:43] Received request cmpl-1489eb550736440d92d53bca8d66bd53-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nThat this huge stage presenteth nought but shows\nVaunt in their youthful sap, at height decrease,\nAnd you must live, drawn by your own sweet skill.\nThey draw but what they see, know not the heart.\nTake all my comfort of thy worth and truth.\nBut if the while I think on thee, dear friend,\nTo hideous winter and confounds him there;\nAuthorizing thy trespass with compare,\nShe carved thee for her seal, and meant thereby\nSets you most rich in youth before my sight,\nTo see his active child do deeds of youth,\nHow can I then be elder than thou art?\nIf thou couldst answer 'This fair child of mine\nAnd from the forlorn world his visage hide,\nTo him that bears the strong offence's cross.\nThe eyes, 'fore duteous, now converted are\nWho for thyself art so unprovident.\nWith ugly rack on his celestial face,\nAnd by a part of all thy glory live.\nWhen I do count the clock that tells the time,\nIn one of thine, from that which thou departest;\nAnd make me travel forth without my cloak,\nI make my love engrafted to this store:\nBut day by night, and night by day, oppress'd?\nWhich happies those that pay the willing loan;\nOf plagues, of dearths, or seasons' quality;\nAs, thou being mine, mine is thy good report.\nWishing me like to one more rich in hope,\nSince sweets and beauties do themselves forsake<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 6372, 672, 7186, 5552, 1861, 1064, 226774, 840, 3831, 107, 45994, 3012, 528, 910, 68765, 23588, 236764, 657, 3558, 11086, 236764, 107, 3133, 611, 1921, 3892, 236764, 9710, 684, 822, 1852, 9380, 12889, 236761, 107, 7634, 4988, 840, 1144, 901, 1460, 2