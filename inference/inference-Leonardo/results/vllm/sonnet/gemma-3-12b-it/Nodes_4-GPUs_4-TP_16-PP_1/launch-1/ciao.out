INFO 09-15 16:12:58 [logger.py:43] Received request cmpl-8941a8bd57cc4ad286f31b05eb48648c-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nOr to thyself at least kind-hearted prove:\nThis wish I have; then ten times happy me!The region cloud hath mask'd him from me now.\nPointing to each his thunder, rain and wind,\nThat heals the wound and cures not the disgrace:\nMusic to hear, why hear'st thou music sadly?\nFor all that beauty that doth cover thee\nSo I, for fear of trust, forget to say\nThat 'gainst thyself thou stick'st not to conspire.\nLike feeble age, he reeleth from the day,\nAnd 'gainst myself a lawful plea commence:\nI will not praise that purpose not to sell.\nOf plagues, of dearths, or seasons' quality;\nEven so my sun one early morn did shine\nThat heaven's air in this huge rondure hems.\nThe world will be thy widow and still weep\nBut day by night, and night by day, oppress'd?\nSo long as men can breathe or eyes can see,\nAnd every fair from fair sometime declines,\nHow far I toil, still farther off from thee.\nLo! thus, by day my limbs, by night my mind,\nThat thou among the wastes of time must go,\nWhen sparkling stars twire not thou gild'st the even.\nYou should live twice; in it and in my rhyme.\nWhilst I, whom fortune of such triumph bars,\nThe dear repose for limbs with travel tired;\nEven so my sun one early morn did shine\nTo dry the rain on my storm-beaten face,\nSo long as men can breathe or eyes can see,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 3524, 531, 208224, 883, 657, 3198, 2712, 236772, 59139, 8595, 236787, 107, 2094, 7976, 564, 735, 236793, 1299, 3595, 2782, 5293, 786, 236888, 818, 4128, 6425, 46440, 7441, 236789, 236753, 1515, 699, 786, 1492, 236761, 107, 227805, 531, 1546, 914, 41796,