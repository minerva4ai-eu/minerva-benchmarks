INFO 09-15 16:10:38 [logger.py:43] Received request cmpl-80da9df348184c698019056deb7d3c15-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nThe world will be thy widow and still weep\nEven so my sun one early morn did shine\nIn thee thy summer, ere thou be distill'd:\nVaunt in their youthful sap, at height decrease,\nLest my bewailed guilt should do thee shame,\nThat on himself such murderous shame commits.\nWhose fresh repair if now thou not renewest,\nTo see his active child do deeds of youth,\nMine be thy love and thy love's use their treasure.\nBy unions married, do offend thine ear,\nOf public honour and proud titles boast,\nFor no man well of such a salve can speak\nFor to thy sensual fault I bring in sense--\nWhich this, Time's pencil, or my pupil pen,\nAgainst the stormy gusts of winter's day\nLet me confess that we two must be twain,\nBorne on the bier with white and bristly beard,\nAnd die as fast as they see others grow;\nProfitless usurer, why dost thou use\nNature's bequest gives nothing but doth lend,\nTo see his active child do deeds of youth,\nAn eye more bright than theirs, less false in rolling,\nExcusing thy sins more than thy sins are;\nYou had a father: let your son say so.\nDisdains the tillage of thy husbandry?\nA woman's gentle heart, but not acquainted\nAs fast as thou shalt wane, so fast thou growest\nMusic to hear, why hear'st thou music sadly?\nThat hath his windows glazed with thine eyes.<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 818, 1902, 795, 577, 21820, 39557, 532, 2036, 137531, 107, 14986, 834, 1041, 3768, 886, 3649, 62323, 1602, 29369, 107, 902, 44543, 21820, 5312, 236764, 16509, 35627, 577, 102083, 236789, 236753, 236787, 107, 45994, 3012, 528, 910, 68765, 23588, 236764, 657, 3558, 110