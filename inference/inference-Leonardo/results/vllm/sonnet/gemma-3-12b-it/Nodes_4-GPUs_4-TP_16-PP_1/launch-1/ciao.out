INFO 09-15 16:14:31 [logger.py:43] Received request cmpl-902f8c140d404b949f808523ec7c20ba-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nA dearer birth than this his love had brought,\nThat hath his windows glazed with thine eyes.\nRoses have thorns, and silver fountains mud;\nSo should the lines of life that life repair,\nO, therefore, love, be of thyself so wary\nNow stand you on the top of happy hours,\nNo more be grieved at that which thou hast done:\nHow can I then return in happy plight,\nBut since she prick'd thee out for women's pleasure,\nSo great a sum of sums, yet canst not live?\nTo let base clouds o'ertake me in my way,\nYet, do thy worst, old Time: despite thy wrong,\nYourself again after yourself's decease,\nWeary with toil, I haste me to my bed,\nFor beauty's pattern to succeeding men.\nAnd stretched metre of an antique song:\nAnd keep my drooping eyelids open wide,\nWill be a tatter'd weed, of small worth held:\nTo thee I send this written embassage,\nYet, do thy worst, old Time: despite thy wrong,\nAnd dost him grace when clouds do blot the heaven:\nAnd 'gainst myself a lawful plea commence:\nWho all their parts of me to thee did give;\nMaking a famine where abundance lies,\nBe scorn'd like old men of less truth than tongue,\nNot from the stars do I my judgment pluck;\nThat thou among the wastes of time must go,\nThy adverse party is thy advocate--\nAnd dost him grace when clouds do blot the heaven:<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 236776, 23348, 497, 6681, 1082, 672, 914, 2765, 1053, 6111, 236764, 107, 6372, 46440, 914, 11665, 77842, 607, 162531, 6114, 236761, 107, 205251, 735, 140576, 236764, 532, 10173, 136411, 14791, 236793, 107, 4324, 1374, 506, 4463, 529, 1972, 600, 1972, 11790, 236764