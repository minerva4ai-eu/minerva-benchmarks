INFO 09-15 16:08:20 [logger.py:43] Received request cmpl-66fbf739e89e4ec3a3defafad00c4970-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nThough in our lives a separable spite,\nWhose strength's abundance weakens his own heart.\nTheir images I loved I view in thee,\nSo thou, thyself out-going in thy noon,\nYou should live twice; in it and in my rhyme.\nAnd, tender churl, makest waste in niggarding.\nAnd yet methinks I have astronomy,\nIf it were fill'd with your most high deserts?\nResembling strong youth in his middle age,\nIntend a zealous pilgrimage to thee,\nAttending on his golden pilgrimage;\nTo be death's conquest and make worms thine heir.\nSo flatter I the swart-complexion'd night,\nThough thou repent, yet I have still the loss:\nAnd loathsome canker lives in sweetest bud.\nFlatter the mountain-tops with sovereign eye,\nIf the true concord of well-tuned sounds,\nThe perfect ceremony of love's rite,\nTill Nature, as she wrought thee, fell a-doting,\nThis were to be new made when thou art old,\nBy children's eyes her husband's shape in mind.\nBut when in thee time's furrows I behold,\nA dearer birth than this his love had brought,\nAnd night doth nightly make grief's strength seem stronger.\nThy bosom is endeared with all hearts,\nAnd stretched metre of an antique song:\nWithout thy help by me be borne alone.\nO, let my books be then the eloquence\nHerein lives wisdom, beauty and increase:<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 31382, 528, 1023, 6176, 496, 82155, 28719, 236764, 107, 2825, 888, 6332, 236789, 236751, 26444, 187168, 914, 1852, 3710, 236761, 107, 37107, 4876, 564, 9312, 564, 1927, 528, 44543, 236764, 107, 4324, 35627, 236764, 208224, 883, 855, 236772, 8946, 528, 21820, 37170, 236764, 107, 3048, 1374, 3892, 10911, 236793, 528, 625, 532, 528, 1041, 117370, 236761, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 3133, 3819, 17914, 24255, 564, 735, 80508, 236764, 107, 2859, 625, 964, 5727, 236789, 236753, 607, 822, 1346, 1494, 119245, 236881, 107, 1988, 581, 13599, 3188, 10974, 528, 914, 6029, 3911, 236764, 107, 3898, 643, 496, 190303, 88762, 531, 44543, 236764, 107, 5466, 2669, 580, 914, 13935, 88762, 236793, 107, 2021, 577, 4355, 236789, 236751, 69393, 532, 1386, 68468, 162531, 49967, 236761, 107, 4324, 111771, 564, 506, 2353, 661, 236772, 34622, 526, 236789, 236753, 3446, 236764, 107, 31382, 35627, 58163, 236764, 3819, 564, 735, 2036, 506, 3967, 236787, 107, 3133, 1510, 651, 19256, 740, 5806, 6176, 528, 155753, 5207, 236761, 107, 6720, 2737, 506, 10565, 236772, 71133, 607, 43284, 7068, 236764, 107, 2859, 506, 1847, 71157, 529, 1388, 236772, 100526, 12054, 236764, 107, 818, 4011, 17620, 529, 2765, 236789, 236751, 106366, 236764, 107, 112222, 15007, 236764, 618, 1304, 82326, 44543, 236764, 11561, 496, 236772, 8465, 522, 236764, 107, 2094, 964, 531, 577, 861, 1603, 1056, 35627, 1610, 2255, 236764, 107, 2292, 2940, 236789, 236751, 6114, 1116, 8705, 236789, 236751, 6230, 528, 3666, 236761, 107, 4573, 1056, 528, 44543, 990, 236789, 236751, 13969, 4290, 564, 67028, 236764, 107, 236776, 23348, 497, 6681, 1082, 672, 914, 2765, 1053, 6111, 236764, 107, 3133, 3446, 139092, 101758, 1386, 32717, 236789, 236751, 6332, 4483, 15281, 236761, 107, 195297, 147851, 563, 22356, 1792, 607, 784, 17500, 236764, 107, 3133, 39349, 58194, 529, 614, 34323, 5410, 236787, 107, 33142, 21820, 1601, 684, 786, 577, 45048, 7057, 236761, 107, 236806, 236764, 1531, 1041, 6249, 577, 1299, 506, 184980, 107, 8291, 495, 6176, 23069, 236764, 9899, 532, 3553, 236787, 106, 107, 105, 4368, 107], prompt_embeds shape: None, lora_request: None, prompt_adapter_request: None.
