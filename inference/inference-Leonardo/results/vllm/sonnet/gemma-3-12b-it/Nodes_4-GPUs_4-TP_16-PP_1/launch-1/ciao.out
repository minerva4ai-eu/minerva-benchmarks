INFO 09-15 16:13:56 [logger.py:43] Received request cmpl-ad854d342d9b4d45bdef790d01db9651-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nLet those who are in favour with their stars\nDuty so great, which wit so poor as mine\nAs interest of the dead, which now appear\nThou art the grave where buried love doth live,\nAnd that fresh blood which youngly thou bestowest\nAs truth and beauty shall together thrive,\nTo that sweet thief which sourly robs from me.\nGilding the object whereupon it gazeth;\nYet eyes this cunning want to grace their art;\nTill then not show my head where thou mayst prove me.\nClouds and eclipses stain both moon and sun,\nAnd fortify yourself in your decay\nHaply I think on thee, and then my state,\nThe age to come would say 'This poet lies:\nWhich husbandry in honour might uphold\nBut day by night, and night by day, oppress'd?\nWho plead for love and look for recompense\nAnd summer's green all girded up in sheaves\nBearing thy heart, which I will keep so chary\nThy unused beauty must be tomb'd with thee,\nAh! but those tears are pearl which thy love sheds,\nThy youth's proud livery, so gazed on now,\nThou art thy mother's glass, and she in thee\nAnd puts apparel on my tatter'd loving,\nWhen to the sessions of sweet silent thought\nExcusing thy sins more than thy sins are;\nSo should the lines of life that life repair,\nSuch civil war is in my love and hate\nO, carve not with thy hours my love's fair brow,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 6481, 1724, 1015, 659, 528, 10144, 607, 910, 8197, 107, 116195, 834, 1822, 236764, 837, 32950, 834, 6934, 618, 10701, 107, 2205, 2142, 529, 506, 6582, 236764, 837, 1492, 3196, 107, 178651, 1610, 506, 23674, 1298, 29051, 2765, 139092, 3892, 236764, 107, 31