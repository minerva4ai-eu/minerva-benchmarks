INFO 09-15 16:08:42 [logger.py:43] Received request cmpl-e51e0e954ca648d3835e5016868185c3-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nO, let my books be then the eloquence\nIf it were fill'd with your most high deserts?\nWhen I consider every thing that grows\nSo long as men can breathe or eyes can see,\nThy adverse party is thy advocate--\nAs interest of the dead, which now appear\nHis tender heir might bear his memory:\nAnd heavily from woe to woe tell o'er\nAnd all in war with Time for love of you,\nSo I, made lame by fortune's dearest spite,\nNor it nor no remembrance what it was:\nAnd though they be outstripp'd by every pen,\nAnd make the earth devour her own sweet brood;\nMake thee another self, for love of me,\nClouds and eclipses stain both moon and sun,\nAs any mother's child, though not so bright\nWhen to the sessions of sweet silent thought\nAnd many maiden gardens yet unset\nO, that you were yourself! but, love, you are\nAnd from the forlorn world his visage hide,\nNow stand you on the top of happy hours,\nBut when from highmost pitch, with weary car,\nWhilst I, whom fortune of such triumph bars,\nHow far I toil, still farther off from thee.\nThe offender's sorrow lends but weak relief\nWhere I may not remove nor be removed.\nThat thou among the wastes of time must go,\nOr else receivest with pleasure thine annoy?\nBearing thy heart, which I will keep so chary<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 236806, 236764, 1531, 1041, 6249, 577, 1299, 506, 184980, 107, 2859, 625, 964, 5727, 236789, 236753, 607, 822, 1346, 1494, 119245, 236881, 107, 4420, 564, 1966, 1418, 3210, 600, 23897, 107, 4324, 1440, 618, 1758, 740, 38893, 653, 6114, 740, 1460, 236764, 107, 195297, 23779, 4598, 563, 21820, 32371, 726, 10