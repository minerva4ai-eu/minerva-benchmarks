INFO 09-15 16:12:37 [logger.py:43] Received request cmpl-9fc79a4c8def4ec48f64484032c26f2c-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nSo should that beauty which you hold in lease\nThen what could death do, if thou shouldst depart,\nA man in hue, all 'hues' in his controlling,\nAnd dumb presagers of my speaking breast,\nFor at a frown they in their glory die.\nWho plead for love and look for recompense\nFrom sullen earth, sings hymns at heaven's gate;\nWhen sparkling stars twire not thou gild'st the even.\nLooking on darkness which the blind do see\nWhich though it alter not love's sole effect,\nBe, as thy presence is, gracious and kind,\nAnd many maiden gardens yet unset\nBut flowers distill'd though they with winter meet,\nAnd die as fast as they see others grow;\nThe world will wail thee, like a makeless wife;\nWhich bounteous gift thou shouldst in bounty cherish:\nWhat acceptable audit canst thou leave?\nOr some fierce thing replete with too much rage,\nYourself again after yourself's decease,\nFor beauty's pattern to succeeding men.\nLook, what an unthrift in the world doth spend\nDuty so great, which wit so poor as mine\nIs from the book of honour razed quite,\nAs, thou being mine, mine is thy good report.\nWho will believe my verse in time to come,\nIf from thyself to store thou wouldst convert;\nThy youth's proud livery, so gazed on now,\nNor lose possession of that fair thou owest;\nGreat princes' favourites their fair leaves spread<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 4324, 1374, 600, 9899, 837, 611, 2768, 528, 20850, 107, 11407, 1144, 1451, 4355, 776, 236764, 768, 35627, 1374, 540, 5118, 236764, 107, 236776, 880, 528, 37766, 236764, 784, 756, 236754, 1303, 236789, 528, 914, 23689, 236764, 107, 3133,