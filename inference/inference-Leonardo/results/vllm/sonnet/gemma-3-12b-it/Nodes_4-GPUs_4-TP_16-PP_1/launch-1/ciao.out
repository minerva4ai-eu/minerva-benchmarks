INFO 09-15 16:09:24 [logger.py:43] Received request cmpl-f91c6be51ca040e88d237568af981ff7-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nFor through the painter must you see his skill,\nThen look I death my days should expiate.\nSave that my soul's imaginary sight\nYet, do thy worst, old Time: despite thy wrong,\nThat's for thyself to breed another thee,\nThat heaven's air in this huge rondure hems.\nThey do but sweetly chide thee, who confounds\nBut that I hope some good conceit of thine\nO, let my books be then the eloquence\nAnd fortify yourself in your decay\nStealing unseen to west with this disgrace:\nThen of thy beauty do I question make,\nThat I in thy abundance am sufficed\nBearing thy heart, which I will keep so chary\nFor no man well of such a salve can speak\nAnd every fair with his fair doth rehearse\nOr some fierce thing replete with too much rage,\nFeatured like him, like him with friends possess'd,\nSince sweets and beauties do themselves forsake\nMyself corrupting, salving thy amiss,\nEntitled in thy parts do crowned sit,\nyet mortal looks adore his beauty still,\nProfitless usurer, why dost thou use\nNor thou with public kindness honour me,\nBut beauty's waste hath in the world an end,\nMaking a famine where abundance lies,\nO'ercharged with burden of mine own love's might.\nWhich, like a jewel hung in ghastly night,\nWhen sparkling stars twire not thou gild'st the even.<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 2542, 1343, 506, 42289, 1921, 611, 1460, 914, 12889, 236764, 107, 11407, 1385, 564, 4355, 1041, 2668, 1374, 1520, 17818, 236761, 107, 14000, 600, 1041, 12556, 236789, 236751, 47456, 14186, 107, 40524, 236764, 776, 21820, 14588, 236764, 2255, 7578, 236787, 9785, 21820, 6133, 236764, 107, 6372,