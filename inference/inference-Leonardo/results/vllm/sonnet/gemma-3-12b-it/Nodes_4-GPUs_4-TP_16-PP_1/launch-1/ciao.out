INFO 09-15 16:13:56 [logger.py:43] Received request cmpl-52ffcf574d7e4dc1ad2305e6fa6b65ce-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nAnd your sweet semblance to some other give.\nIf from thyself to store thou wouldst convert;\nNor it nor no remembrance what it was:\nDelights to peep, to gaze therein on thee;\nBut since she prick'd thee out for women's pleasure,\nAs interest of the dead, which now appear\nFor having traffic with thyself alone,\nIf ten of thine ten times refigured thee:\nWhen your sweet issue your sweet form should bear.\nIs it for fear to wet a widow's eye\nFor thou art so possess'd with murderous hate\nNot from the stars do I my judgment pluck;\nAnd yet methinks I have astronomy,\nHim in thy course untainted do allow\nDo in consent shake hands to torture me;\nWith shifting change, as is false women's fashion;\nSuns of the world may stain when heaven's sun staineth.\nFor where is she so fair whose unear'd womb\nUnlook'd for joy in that I honour most.\nAnd in themselves their pride lies buried,\nMyself corrupting, salving thy amiss,\nFor all that beauty that doth cover thee\nFor then my thoughts, from far where I abide,\nYou should live twice; in it and in my rhyme.\nSo thou through windows of thine age shall see\nThou of thyself thy sweet self dost deceive.\nBut were some child of yours alive that time,\nAnd perspective it is the painter's art.\nHolds in perfection but a little moment,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 3133, 822, 9380, 178837, 531, 1070, 1032, 2583, 236761, 107, 2859, 699, 208224, 883, 531, 4762, 35627, 1093, 540, 7352, 236793, 107, 31777, 625, 6271, 951, 103209, 1144, 625, 691, 236787, 107, 12846, 4821, 531, 154312, 236764, 531, 48674, 33025, 580, 44543, 236793, 107, 4573,