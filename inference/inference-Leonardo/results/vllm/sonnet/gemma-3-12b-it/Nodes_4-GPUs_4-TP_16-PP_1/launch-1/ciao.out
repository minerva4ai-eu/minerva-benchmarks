INFO 09-15 16:14:08 [logger.py:43] Received request cmpl-67f0cae312474e6f9d3e9a117b9bf9fe-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nHim in thy course untainted do allow\nAnd by addition me of thee defeated,\nAs interest of the dead, which now appear\nNor can I fortune to brief minutes tell,\nWhy lovest thou that which thou receivest not gladly,\nTo see his active child do deeds of youth,\nTo march in ranks of better equipage:\nAs fast as thou shalt wane, so fast thou growest\nWhich though it alter not love's sole effect,\nOr ten times happier, be it ten for one;\nFor never-resting time leads summer on\nWhich I by lacking have supposed dead,\nAnd dig deep trenches in thy beauty's field,\nFeed'st thy light'st flame with self-substantial fuel,\nUnless thou take that honour from thy name:\nBut if thou live, remember'd not to be,\nBut day by night, and night by day, oppress'd?\nIn one of thine, from that which thou departest;\nSo long as youth and thou are of one date;\nNor lose possession of that fair thou owest;\nThat use is not forbidden usury,\nWhat acceptable audit canst thou leave?\nWho plead for love and look for recompense\nWho all in one, one pleasing note do sing:\nWith April's first-born flowers, and all things rare\nSo thou, thyself out-going in thy noon,\nThe sad account of fore-bemoaned moan,\nBut when in thee time's furrows I behold,\nThe region cloud hath mask'd him from me now.<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 142437, 528, 21820, 3003, 2225, 25197, 776, 2174, 107, 3133, 684, 2517, 786, 529, 44543, 27522, 236764, 107, 2205, 2142, 529, 506, 6582, 236764, 837, 1492, 3196, 107, 31777, 740, 564, 31252, 531, 8652, 4310, 3442, 236764, 107, 11355, 7278, 598, 35627, 600, 837, 35627, 2252, 648, 598, 71