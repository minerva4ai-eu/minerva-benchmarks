INFO 09-15 16:08:31 [logger.py:43] Received request cmpl-5ea0ad5bc62f4963847887d222e29741-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nStrikes each in each by mutual ordering,\nIn our two loves there is but one respect,\nBy chance or nature's changing course untrimm'd;\nI will not praise that purpose not to sell.\nThe bounteous largess given thee to give?\nWhich I new pay as if not paid before.\nThe world will wail thee, like a makeless wife;\nSo shall those blots that do with me remain\nThou art more lovely and more temperate:\nLeaving thee living in posterity?\nSo I, for fear of trust, forget to say\nBut that thou none lovest is most evident;\nWill play the tyrants to the very same\nSo long lives this and this gives life to thee.\nNor draw no lines there with thine antique pen;\nFor then my thoughts, from far where I abide,\n'Tis not enough that through the cloud thou break,\nIs it for fear to wet a widow's eye\nBut things removed that hidden in thee lie!\nAnd your true rights be term'd a poet's rage\nA liquid prisoner pent in walls of glass,\nWhen sparkling stars twire not thou gild'st the even.\nWhereon the stars in secret influence comment;\nAs any mother's child, though not so bright\nThat thereby beauty's rose might never die,\nGrant, if thou wilt, thou art beloved of many,\nWhich in thy breast doth live, as thine in me:\nThy youth's proud livery, so gazed on now,\nBut flowers distill'd though they with winter meet,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 155124, 10877, 1546, 528, 1546, 684, 21281, 24121, 236764, 107, 902, 1023, 1156, 18178, 993, 563, 840, 886, 2833, 236764, 107, 2292, 6584, 653, 4135, 236789, 236751, 9199, 3003, 2225, 4966, 236757, 236789, 236753, 236793, 107, 236777, 795, 711, 30450, 600,