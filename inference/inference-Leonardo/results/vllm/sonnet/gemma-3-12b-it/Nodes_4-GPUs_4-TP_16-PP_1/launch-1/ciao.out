INFO 09-15 16:14:20 [logger.py:43] Received request cmpl-ae8b4742a3f64a94b21b0d58e86a3bc7-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nNeither in inward worth nor outward fair,\nYou had a father: let your son say so.\nAnd thou, all they, hast all the all of me.\nBeauty's effect with beauty were bereft,\nDoth homage to his new-appearing sight,\nSo should the lines of life that life repair,\nAfter a thousand victories once foil'd,\nAnd moan the expense of many a vanish'd sight:\nThy youth's proud livery, so gazed on now,\nMusic to hear, why hear'st thou music sadly?\nMaking a famine where abundance lies,\nHow can I then return in happy plight,\n'Tis not enough that through the cloud thou break,\nThose hours, that with gentle work did frame\nThat I an accessary needs must be\nWhich though it alter not love's sole effect,\nWith sun and moon, with earth and sea's rich gems,\nDesiring this man's art and that man's scope,\nStrikes each in each by mutual ordering,\nMore than that tongue that more hath more express'd.\nMy body is the frame wherein 'tis held,\nAnd make me travel forth without my cloak,\nThat thou consumest thyself in single life?\nProfitless usurer, why dost thou use\nWhen to the sessions of sweet silent thought\nWhen that churl Death my bones with dust shall cover,\nPresents thy shadow to my sightless view,\nThen being ask'd where all thy beauty lies,\nThou art thy mother's glass, and she in thee<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 95889, 528, 58258, 5367, 6271, 44630, 5888, 236764, 107, 3048, 1053, 496, 6353, 236787, 1531, 822, 2369, 1879, 834, 236761, 107, 3133, 35627, 236764, 784, 901, 236764, 23823, 784, 506, 784, 529, 786, 236761, 107, 74722, 236789, 236751, 1763, 607, 9899, 964, 17322, 765, 23676