INFO 09-15 16:13:08 [logger.py:43] Received request cmpl-00da0a46ee1e44e89a36f1a6d528c9bd-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nLook in thy glass, and tell the face thou viewest\nThat 'gainst thyself thou stick'st not to conspire.\nIntend a zealous pilgrimage to thee,\nWhy lovest thou that which thou receivest not gladly,\nAnd summer's lease hath all too short a date:\nMaking a couplement of proud compare,\nBut do not so; I love thee in such sort\nProfitless usurer, why dost thou use\nThy merit hath my duty strongly knit,\nSo flatter I the swart-complexion'd night,\nSo should the lines of life that life repair,\nLord of my love, to whom in vassalage\nAnd there reigns love and all love's loving parts,\nAnd barren rage of death's eternal cold?\nLord of my love, to whom in vassalage\nBut then begins a journey in my head,\nExceeded by the height of happier men.\nFeed'st thy light'st flame with self-substantial fuel,\nWhich, used, lives th' executor to be.\nAs I, not for myself, but for thee will;\nAnd there reigns love and all love's loving parts,\nTo work my mind, when body's work's expired:\nA woman's gentle heart, but not acquainted\nSometime too hot the eye of heaven shines,\nAnd all in war with Time for love of you,\nRough winds do shake the darling buds of May,\nTo be death's conquest and make worms thine heir.\nO, that you were yourself! but, love, you are\nWeary with toil, I haste me to my bed,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 13908, 528, 21820, 4896, 236764, 532, 3442, 506, 3392, 35627, 1927, 598, 107, 6372, 756, 51775, 540, 208224, 883, 35627, 6568, 236789, 540, 711, 531, 46112, 750, 236761, 107, 3898, 643, 496, 190303, 88762, 531, 44543, 236764, 107, 11355, 7278, 598, 35627, 600, 837, 35627, 2