INFO 09-15 16:07:57 [logger.py:43] Received request cmpl-d6f77bb35f8847cb8e7965a500f35a1d-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nSuch heavenly touches ne'er touch'd earthly faces.'\nBe scorn'd like old men of less truth than tongue,\nLike to the lark at break of day arising\nAnd trouble deal heaven with my bootless cries\nLeese but their show; their substance still lives sweet.\nMy body is the frame wherein 'tis held,\nYet, do thy worst, old Time: despite thy wrong,\nMaking a famine where abundance lies,\nThat's for thyself to breed another thee,\nAfter a thousand victories once foil'd,\nBut from thine eyes my knowledge I derive,\nLest my bewailed guilt should do thee shame,\nBut I forbid thee one most heinous crime:\nBut that I hope some good conceit of thine\nLeese but their show; their substance still lives sweet.\nNor shall Death brag thou wander'st in his shade,\nWhen day's oppression is not eased by night,\nThat due of many now is thine alone:\nBy unions married, do offend thine ear,\nSets you most rich in youth before my sight,\nBy chance or nature's changing course untrimm'd;\nIf I could write the beauty of your eyes\nBut thy eternal summer shall not fade\nThou shouldst print more, not let that copy die.\nBut if the while I think on thee, dear friend,\nThe offender's sorrow lends but weak relief\nO, none but unthrifts! Dear my love, you know\nNow see what good turns eyes for eyes have done:\nHolds in perfection but a little moment,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 28576, 67110, 33466, 770, 236789, 497, 6374, 236789, 236753, 92872, 13799, 7085, 107, 3912, 121391, 236789, 236753, 1133, 2255, 1758, 529, 2344, 9043, 1082, 28166, 236764, 107, 17729, 531, 506, 218175, 657, 2541, 529, 1719, 27123, 10