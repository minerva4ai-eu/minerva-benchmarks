INFO 09-15 16:12:17 [logger.py:43] Received request cmpl-64d3651e59224c828e80298b7a8f4704-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nBut when from highmost pitch, with weary car,\nThough thou repent, yet I have still the loss:\nWith means more blessed than my barren rhyme?\nGilding pale streams with heavenly alchemy;\nIn thy soul's thought, all naked, will bestow it;\nWishing me like to one more rich in hope,\nAttending on his golden pilgrimage;\nAre windows to my breast, where-through the sun\nMy glass shall not persuade me I am old,\nHast thou, the master-mistress of my passion;\nWhich bounteous gift thou shouldst in bounty cherish:\nWhich happies those that pay the willing loan;\nIs from the book of honour razed quite,\nAnd from the forlorn world his visage hide,\nFor never-resting time leads summer on\nAttending on his golden pilgrimage;\nDesiring this man's art and that man's scope,\nLeaving thee living in posterity?\nThese poor rude lines of thy deceased lover,\nBut from thine eyes my knowledge I derive,\nWhich hides your life and shows not half your parts.\nNo love toward others in that bosom sits\nSo should my papers yellow'd with their age\nSo I, made lame by fortune's dearest spite,\nAnd all those friends which I thought buried.\nBut thou, contracted to thine own bright eyes,\nUnlook'd on diest, unless thou get a son.\nThey draw but what they see, know not the heart.\nThou gavest me thine, not to give back again.<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 4573, 1056, 699, 1494, 3374, 12861, 236764, 607, 78567, 1295, 236764, 107, 31382, 35627, 58163, 236764, 3819, 564, 735, 2036, 506, 3967, 236787, 107, 3497, 2820, 919, 31865, 1082, 1041, 96782, 117370, 236881, 107, 236823, 938, 522, 24327, 25568, 607, 671