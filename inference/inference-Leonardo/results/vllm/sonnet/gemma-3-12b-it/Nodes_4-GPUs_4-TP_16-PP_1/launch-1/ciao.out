INFO 09-15 16:13:19 [logger.py:43] Received request cmpl-94672cd56f074188bfe9d7f8d39ac51a-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nFeatured like him, like him with friends possess'd,\nAnd all the rest forgot for which he toil'd:\nWith means more blessed than my barren rhyme?\nAnd burn the long-lived phoenix in her blood;\nYet, do thy worst, old Time: despite thy wrong,\nVaunt in their youthful sap, at height decrease,\nLest my bewailed guilt should do thee shame,\nAnd in themselves their pride lies buried,\nSap cheque'd with frost and lusty leaves quite gone,\nIn thy soul's thought, all naked, will bestow it;\nThe world will be thy widow and still weep\nFor beauty's pattern to succeeding men.\nNow stand you on the top of happy hours,\nWhich, used, lives th' executor to be.\nHerein lives wisdom, beauty and increase:\nAnd all in war with Time for love of you,\nBut were some child of yours alive that time,\nFor thy sweet love remember'd such wealth brings\nSets you most rich in youth before my sight,\nSo thou, thyself out-going in thy noon,\nLifts up his burning head, each under eye\nWho will believe my verse in time to come,\nTo show me worthy of thy sweet respect:\nSince sweets and beauties do themselves forsake\nAnd moan the expense of many a vanish'd sight:\nYet, do thy worst, old Time: despite thy wrong,\nWhat acceptable audit canst thou leave?\nFor through the painter must you see his skill,\nO, therefore, love, be of thyself so wary<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 83917, 1133, 1515, 236764, 1133, 1515, 607, 4690, 12868, 236789, 236753, 236764, 107, 3133, 784, 506, 1884, 18492, 573, 837, 668, 141001, 236789, 236753, 236787, 107, 3497, 2820, 919, 31865, 1082, 1041, 96782, 117370, 236881, 107, 3133, 8