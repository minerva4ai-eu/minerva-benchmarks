INFO 09-15 16:14:43 [logger.py:43] Received request cmpl-df2d8c57f3e64f42bcb8ddd2609d487d-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nNor can thy shame give physic to my grief;\nAlthough our undivided loves are one:\nThe painful warrior famoused for fight,\nThat I in thy abundance am sufficed\nWhich I by lacking have supposed dead,\nFeatured like him, like him with friends possess'd,\nPity the world, or else this glutton be,\nWhy lovest thou that which thou receivest not gladly,\nWhen I consider every thing that grows\nWith ugly rack on his celestial face,\n'Had my friend's Muse grown with this growing age,\nWho for thyself art so unprovident.\nResembling strong youth in his middle age,\nThe region cloud hath mask'd him from me now.\nAnd make me travel forth without my cloak,\nA woman's gentle heart, but not acquainted\nTill Nature, as she wrought thee, fell a-doting,\nThat on himself such murderous shame commits.\nThou art thy mother's glass, and she in thee\nAfter a thousand victories once foil'd,\nFor then my thoughts, from far where I abide,\nIf all were minded so, the times should cease\nSo great a sum of sums, yet canst not live?\nWeary with toil, I haste me to my bed,\nSo is it not with me as with that Muse\nNor thou with public kindness honour me,\nIn singleness the parts that thou shouldst bear.\nI tell the day, to please them thou art bright\nResembling sire and child and happy mother<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 31777, 740, 21820, 30720, 2583, 58636, 531, 1041, 32717, 236793, 107, 13518, 1023, 161968, 18178, 659, 886, 236787, 107, 818, 27668, 45850, 9639, 524, 573, 6093, 236764, 107, 6372, 564, 528, 21820, 26444, 1006, 664, 2773, 524, 107, 24249, 564, 684, 31329, 735, 11750, 6582, 236764, 10