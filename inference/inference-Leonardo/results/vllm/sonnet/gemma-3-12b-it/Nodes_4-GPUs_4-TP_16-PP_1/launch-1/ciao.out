INFO 09-15 16:08:43 [logger.py:43] Received request cmpl-8ba9963631a34fc5865c56124b292c8d-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nNor lose possession of that fair thou owest;\nThe perfect ceremony of love's rite,\nBut day doth daily draw my sorrows longer\nTo march in ranks of better equipage:\nSo long as youth and thou are of one date;\nBut do not so; I love thee in such sort\nFor where is she so fair whose unear'd womb\nYourself again after yourself's decease,\nWhich I new pay as if not paid before.\nAh! if thou issueless shalt hap to die.\nWith means more blessed than my barren rhyme?\nThough yet, heaven knows, it is but as a tomb\nAn eye more bright than theirs, less false in rolling,\nLeese but their show; their substance still lives sweet.\nAnd trouble deal heaven with my bootless cries\nSo I, made lame by fortune's dearest spite,\nThat hath his windows glazed with thine eyes.\nPoints on me graciously with fair aspect\nThat 'gainst thyself thou stick'st not to conspire.\nIf the true concord of well-tuned sounds,\nYou had a father: let your son say so.\nIf all were minded so, the times should cease\nWith means more blessed than my barren rhyme?\nBy adding one thing to my purpose nothing.\nBut I forbid thee one most heinous crime:\nDelights to peep, to gaze therein on thee;\nLook, what an unthrift in the world doth spend\nLo! in the orient when the gracious light\nBut beauty's waste hath in the world an end,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 31777, 10382, 17274, 529, 600, 5888, 35627, 5850, 598, 236793, 107, 818, 4011, 17620, 529, 2765, 236789, 236751, 106366, 236764, 107, 4573, 1719, 139092, 6376, 4988, 1041, 179452, 4890, 107, 2021, 14868, 528, 26867, 529, 2480, 4653, 676, 236787, 107, 4324, 1440,