INFO 09-15 16:12:47 [logger.py:43] Received request cmpl-6400027b5a8041f3adb3b236425af2ec-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nBut beauty's waste hath in the world an end,\nSometime too hot the eye of heaven shines,\nOr some fierce thing replete with too much rage,\nBut that thou none lovest is most evident;\nWith all triumphant splendor on my brow;\nThat 'gainst thyself thou stick'st not to conspire.\nMy glass shall not persuade me I am old,\nBeauty's effect with beauty were bereft,\nWhen to the sessions of sweet silent thought\nThat 'gainst thyself thou stick'st not to conspire.\nAnd your sweet semblance to some other give.\nAnd often is his gold complexion dimm'd;\nWhen forty winters shall beseige thy brow,\nWith means more blessed than my barren rhyme?\nAnd dost him grace when clouds do blot the heaven:\nAs truth and beauty shall together thrive,\nBut as the marigold at the sun's eye,\nI summon up remembrance of things past,\nIn thy soul's thought, all naked, will bestow it;\nTo hear with eyes belongs to love's fine wit.\nAre windows to my breast, where-through the sun\nBorne on the bier with white and bristly beard,\nAnon permit the basest clouds to ride\nBe not self-will'd, for thou art much too fair\nIf all were minded so, the times should cease\nWith all triumphant splendor on my brow;\nThy bosom is endeared with all hearts,\nSuch civil war is in my love and hate\nShall I compare thee to a summer's day?<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 4573, 9899, 236789, 236751, 8321, 46440, 528, 506, 1902, 614, 1345, 236764, 107, 236773, 166276, 2311, 3425, 506, 7068, 529, 20808, 67257, 236764, 107, 3524, 1070, 48621, 3210, 199137, 607, 2311, 1623, 49064, 236764, 107, 4573, 600, 35627, 7293, 7278, 598, 563