INFO 09-15 16:13:56 [logger.py:43] Received request cmpl-7a8a7e2919f64471baf6db48455b5d59-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nSo then I am not lame, poor, nor despised,\nShall hate be fairer lodged than gentle love?\nLike to the lark at break of day arising\nAnd you must live, drawn by your own sweet skill.\nOf plagues, of dearths, or seasons' quality;\nDisdains the tillage of thy husbandry?\nTheirs for their style I'll read, his for his love.'\nTill then not show my head where thou mayst prove me.\nTo dry the rain on my storm-beaten face,\nBe scorn'd like old men of less truth than tongue,\nLord of my love, to whom in vassalage\nTo hideous winter and confounds him there;\nWhere wasteful Time debateth with Decay,\nStrikes each in each by mutual ordering,\nWere an all-eating shame and thriftless praise.\nAlthough our undivided loves are one:\nSings this to thee: 'thou single wilt prove none.'\nWhich happies those that pay the willing loan;\nIf the true concord of well-tuned sounds,\nThy end is truth's and beauty's doom and date.\nAnd every fair with his fair doth rehearse\nTen times thyself were happier than thou art,\nSo then I am not lame, poor, nor despised,\nOr any of these all, or all, or more,\nThat's for thyself to breed another thee,\nBut wherefore do not you a mightier way\nTo thee I send this written embassage,\nAnd from the forlorn world his visage hide,\nMake glad and sorry seasons as thou fleets,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 4324, 1299, 564, 1006, 711, 74907, 236764, 6934, 236764, 6271, 162214, 236764, 107, 172702, 17554, 577, 173410, 81060, 1082, 14617, 2765, 236881, 107, 17729, 531, 506, 218175, 657, 2541, 529, 1719, 27123, 107, 3133, 611, 1921, 3892, 236764, 9710, 684, 822, 1852,