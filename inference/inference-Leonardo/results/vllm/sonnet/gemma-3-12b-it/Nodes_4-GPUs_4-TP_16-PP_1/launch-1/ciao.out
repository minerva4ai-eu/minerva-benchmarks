INFO 09-15 16:08:20 [logger.py:43] Received request cmpl-22f99684e9fb4a7a821f65a041dd29d3-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nI will not praise that purpose not to sell.\nAnd sable curls all silver'd o'er with white;\nWhen I perceive that men as plants increase,\nKissing with golden face the meadows green,\nTill Nature, as she wrought thee, fell a-doting,\nBut when in thee time's furrows I behold,\nAll men make faults, and even I in this,\nAs an unperfect actor on the stage\nThou art more lovely and more temperate:\nBut when from highmost pitch, with weary car,\nMusic to hear, why hear'st thou music sadly?\nNor draw no lines there with thine antique pen;\nIf thou couldst answer 'This fair child of mine\nFor beauty's pattern to succeeding men.\nEven so my sun one early morn did shine\nCheered and cheque'd even by the self-same sky,\nIf thou survive my well-contented day,\nWhen sparkling stars twire not thou gild'st the even.\nWhich I by lacking have supposed dead,\nWhen your sweet issue your sweet form should bear.\nO'ercharged with burden of mine own love's might.\nWhilst I, whom fortune of such triumph bars,\nThou of thyself thy sweet self dost deceive.\nAnd having climb'd the steep-up heavenly hill,\nThen happy I, that love and am beloved\nPresents thy shadow to my sightless view,\nWere an all-eating shame and thriftless praise.\nSo long lives this and this gives life to thee.\nNor shall Death brag thou wander'st in his shade,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 236777, 795, 711, 30450, 600, 5708, 711, 531, 6739, 236761, 107, 3133, 138633, 90526, 784, 10173, 236789, 236753, 512, 236789, 497, 607, 2173, 236793, 107, 4420, 564, 48672, 600, 1758, 618, 6485, 3553, 236764, 107, 174103, 522, 607, 13935, 3