INFO 09-15 16:12:07 [logger.py:43] Received request cmpl-b92d62235b8144e4ba93cfda1d8d4342-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nNo more be grieved at that which thou hast done:\nWith sun and moon, with earth and sea's rich gems,\nResembling strong youth in his middle age,\nAnd though they be outstripp'd by every pen,\nWith all triumphant splendor on my brow;\nAnd sable curls all silver'd o'er with white;\nAfter a thousand victories once foil'd,\nAnd only herald to the gaudy spring,\nAnd loathsome canker lives in sweetest bud.\nAnd barren rage of death's eternal cold?\nLet them say more than like of hearsay well;\nDuty so great, which wit so poor as mine\nAs interest of the dead, which now appear\nBut then begins a journey in my head,\nNo longer yours than you yourself here live:\nMyself corrupting, salving thy amiss,\nThe world will wail thee, like a makeless wife;\nI tell the day, to please them thou art bright\nHim in thy course untainted do allow\nThat 'gainst thyself thou stick'st not to conspire.\nMy love shall in my verse ever live young.\nThat thou among the wastes of time must go,\nWith shifting change, as is false women's fashion;\nResembling sire and child and happy mother\nBe, as thy presence is, gracious and kind,\nFor shame! deny that thou bear'st love to any,\nBut since he died and poets better prove,\nVaunt in their youthful sap, at height decrease,\n'Had my friend's Muse grown with this growing age,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 3771, 919, 577, 66031, 1872, 657, 600, 837, 35627, 23823, 3028, 236787, 107, 3497, 3768, 532, 16254, 236764, 607, 7764, 532, 5442, 236789, 236751, 8326, 53039, 236764, 107, 1988, 581, 13599, 3188, 10974, 528, 914, 6029, 3911, 236764, 107, 3133, 3635, 901, 5