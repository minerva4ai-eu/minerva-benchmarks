INFO 09-15 16:13:56 [logger.py:43] Received request cmpl-3dfea959d72446d5bef3cf3099f2d8de-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nAnon permit the basest clouds to ride\nWhose speechless song, being many, seeming one,\nAnd die as fast as they see others grow;\nWith ugly rack on his celestial face,\nWishing me like to one more rich in hope,\nMuch liker than your painted counterfeit:\nA woman's gentle heart, but not acquainted\nTake all my comfort of thy worth and truth.\nFor then my thoughts, from far where I abide,\nAnd keep my drooping eyelids open wide,\nUnlook'd for joy in that I honour most.\nI make my love engrafted to this store:\nClouds and eclipses stain both moon and sun,\nWhen I do count the clock that tells the time,\nThe age to come would say 'This poet lies:\nThat hath his windows glazed with thine eyes.\nBut beauty's waste hath in the world an end,\nThey draw but what they see, know not the heart.\nTo dry the rain on my storm-beaten face,\nWhen lofty trees I see barren of leaves\nBut from thine eyes my knowledge I derive,\nBe scorn'd like old men of less truth than tongue,\nWhen I perceive that men as plants increase,\nDelights to peep, to gaze therein on thee;\nThis were to be new made when thou art old,\nLike to the lark at break of day arising\nAnd threescore year would make the world away.\nMine eye hath play'd the painter and hath stell'd\nWhich this, Time's pencil, or my pupil pen,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 135705, 9841, 506, 2280, 598, 14958, 531, 11881, 107, 2825, 888, 160132, 5410, 236764, 1646, 1551, 236764, 109785, 886, 236764, 107, 3133, 1778, 618, 4592, 618, 901, 1460, 3496, 2171, 236793, 107, 3497, 37653, 25883, 580, 914, 83798, 3392, 236764, 107, 234207, 786, 1133, 53