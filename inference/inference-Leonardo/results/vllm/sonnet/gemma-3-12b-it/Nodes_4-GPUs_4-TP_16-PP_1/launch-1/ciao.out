INFO 09-15 16:13:56 [logger.py:43] Received request cmpl-a9f7d6e359c44b2da060c382386094bd-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nThat thou among the wastes of time must go,\nFor no man well of such a salve can speak\nOr any of these all, or all, or more,\nWishing me like to one more rich in hope,\nAnd that fresh blood which youngly thou bestowest\nAnd all the rest forgot for which he toil'd:\nAs an unperfect actor on the stage\nAs he takes from you, I engraft you new.\nWhen lofty trees I see barren of leaves\nThou dost beguile the world, unbless some mother.\nThen, were not summer's distillation left,\nLeese but their show; their substance still lives sweet.\nWhen in eternal lines to time thou growest:\nAre windows to my breast, where-through the sun\nAnd look upon myself and curse my fate,\nShall sum my count and make my old excuse,'\nAs interest of the dead, which now appear\nHow much more praise deserved thy beauty's use,\nThat heaven's air in this huge rondure hems.\nHow far I toil, still farther off from thee.\nFor through the painter must you see his skill,\nAlthough our undivided loves are one:\nAgainst the stormy gusts of winter's day\nAs I, not for myself, but for thee will;\nUnthrifty loveliness, why dost thou spend\nAnd then believe me, my love is as fair\nWhich I by lacking have supposed dead,\nThey do but sweetly chide thee, who confounds\nShall hate be fairer lodged than gentle love?<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 6372, 35627, 3571, 506, 45062, 529, 990, 1921, 817, 236764, 107, 2542, 951, 880, 1388, 529, 1288, 496, 150456, 740, 8988, 107, 3524, 1027, 529, 1239, 784, 236764, 653, 784, 236764, 653, 919, 236764, 107, 234207, 786, 1133, 531, 886, 919, 8326, 528, 4614, 236764, 107, 3133, 60