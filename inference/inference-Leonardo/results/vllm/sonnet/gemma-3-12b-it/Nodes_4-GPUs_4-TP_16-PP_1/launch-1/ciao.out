INFO 09-15 16:08:52 [logger.py:43] Received request cmpl-eb1f8ec0ad7d43058f865158e73f5e87-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nThe eyes, 'fore duteous, now converted are\nWhilst that this shadow doth such substance give\nO, change thy thought, that I may change my mind!\nTo hear with eyes belongs to love's fine wit.\nWho heaven itself for ornament doth use\nTheirs for their style I'll read, his for his love.'\nTo that sweet thief which sourly robs from me.\nLike feeble age, he reeleth from the day,\nWhose fresh repair if now thou not renewest,\nAnd having climb'd the steep-up heavenly hill,\nGreat princes' favourites their fair leaves spread\nDelights to peep, to gaze therein on thee;\nThen, were not summer's distillation left,\nAs truth and beauty shall together thrive,\nMusic to hear, why hear'st thou music sadly?\nMake thee another self, for love of me,\nLeaving thee living in posterity?\nWhen to the sessions of sweet silent thought\nCalls back the lovely April of her prime:\nThat I in thy abundance am sufficed\nAnd summer's lease hath all too short a date:\nThou shouldst print more, not let that copy die.\nAnd by a part of all thy glory live.\nBut not to tell of good or evil luck,\nHerein lives wisdom, beauty and increase:\nThe world will wail thee, like a makeless wife;\nFor thee and for myself no quiet find.\nUpon thyself thy beauty's legacy?\nAnd kept unused, the user so destroys it.<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 818, 6114, 236764, 756, 1321, 183004, 806, 236764, 1492, 16952, 659, 107, 96553, 600, 672, 13024, 139092, 1288, 14530, 2583, 107, 236806, 236764, 2352, 21820, 3305, 236764, 600, 564, 1149, 2352, 1041, 3666, 236888, 107, 2021, 6899, 607, 6114, 19681, 531, 2765, 236789, 236751, 5851