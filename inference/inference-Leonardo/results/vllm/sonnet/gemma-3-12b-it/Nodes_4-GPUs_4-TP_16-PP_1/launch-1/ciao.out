INFO 09-15 16:14:32 [logger.py:43] Received request cmpl-d7c32467bffa48c08cd8afb1c570eea3-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nAnon permit the basest clouds to ride\nAnd in mine own love's strength seem to decay,\nUpon thyself thy beauty's legacy?\nHaply I think on thee, and then my state,\nBe, as thy presence is, gracious and kind,\nLet them say more than like of hearsay well;\nAnd barren rage of death's eternal cold?\nKissing with golden face the meadows green,\nTo work my mind, when body's work's expired:\nTo be death's conquest and make worms thine heir.\nMark how one string, sweet husband to another,\nIn singleness the parts that thou shouldst bear.\nAnd moan the expense of many a vanish'd sight:\nHerein lives wisdom, beauty and increase:\nWhere wasteful Time debateth with Decay,\nThyself thy foe, to thy sweet self too cruel.\nSo shall those blots that do with me remain\nDie single, and thine image dies with thee.\nBut were some child of yours alive that time,\nThen, beauteous niggard, why dost thou abuse\nDuty so great, which wit so poor as mine\nAnd perspective it is the painter's art.\nAnd by addition me of thee defeated,\nThy beauty's form in table of my heart;\nLet those who are in favour with their stars\nSets you most rich in youth before my sight,\nBe, as thy presence is, gracious and kind,\nAll men make faults, and even I in this,\nWhose speechless song, being many, seeming one,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 135705, 9841, 506, 2280, 598, 14958, 531, 11881, 107, 3133, 528, 10701, 1852, 2765, 236789, 236751, 6332, 4483, 531, 17538, 236764, 107, 41768, 208224, 883, 21820, 9899, 236789, 236751, 22327, 236881, 107, 236814, 670, 586, 564, 1751, 580, 44543, 236764, 532, 1299, 1041, 1883, 2