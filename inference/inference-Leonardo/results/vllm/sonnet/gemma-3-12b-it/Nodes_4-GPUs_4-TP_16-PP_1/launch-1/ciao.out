INFO 09-15 16:12:27 [logger.py:43] Received request cmpl-c384b6dba7934785aaef99393fbec2dc-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nStrikes each in each by mutual ordering,\nThough in our lives a separable spite,\nThough yet, heaven knows, it is but as a tomb\nThy adverse party is thy advocate--\nBut when from highmost pitch, with weary car,\nDie single, and thine image dies with thee.\nAnd see thy blood warm when thou feel'st it cold.\nCalls back the lovely April of her prime:\nProfitless usurer, why dost thou use\nAnd by a part of all thy glory live.\nThat heaven's air in this huge rondure hems.\nTo show me worthy of thy sweet respect:\nThou of thyself thy sweet self dost deceive.\nO' let me, true in love, but truly write,\nA woman's gentle heart, but not acquainted\nThat hath his windows glazed with thine eyes.\nSo should the lines of life that life repair,\nAnd sable curls all silver'd o'er with white;\nTo that sweet thief which sourly robs from me.\nAnd heavily from woe to woe tell o'er\nWere an all-eating shame and thriftless praise.\nO, that you were yourself! but, love, you are\nNo longer yours than you yourself here live:\nAnd your sweet semblance to some other give.\nTo change your day of youth to sullied night;\nUnthrifty loveliness, why dost thou spend\nyet mortal looks adore his beauty still,\nLo! in the orient when the gracious light\nThat heaven's air in this huge rondure hems.<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 155124, 10877, 1546, 528, 1546, 684, 21281, 24121, 236764, 107, 31382, 528, 1023, 6176, 496, 82155, 28719, 236764, 107, 31382, 3819, 236764, 20808, 10077, 236764, 625, 563, 840, 618, 496, 44064, 107, 195297, 23779, 4598, 563, 21820, 32371, 726, 107, 4573, 1056, 699, 1494, 3374, 12861, 236764, 607, 78567, 1295, 236764, 107, 13034, 3161, 236764, 532, 162531, 2471, 5822, 607, 44543, 236761, 107, 3133, 1460, 21820, 4806, 6962, 1056, 35627, 2597, 236789, 540, 625, 7445, 236761, 107, 78377, 1063, 506, 14954, 5365, 529, 1116, 8355, 236787, 107, 109048, 1933, 775, 7355, 236764, 3217, 24873, 35627, 1161, 107, 3133, 684, 496, 912, 529, 784, 21820, 27877, 3892, 236761, 107, 6372, 20808, 236789, 236751, 2634, 528, 672, 7186, 58664, 694, 231825, 236761, 107, 2021, 1407, 786, 26721, 529, 21820, 9380, 2833, 236787, 107, 178651, 529, 208224, 883, 21820, 9380, 1265, 24873, 81371, 236761, 107, 236806, 236789, 1531, 786, 236764, 1847, 528, 2765, 236764, 840, 9995, 4903, 236764, 107, 236776, 3875, 236789, 236751, 14617, 3710, 236764, 840, 711, 57560, 107, 6372, 46440, 914, 11665, 77842, 607, 162531, 6114, 236761, 107, 4324, 1374, 506, 4463, 529, 1972, 600, 1972, 11790, 236764, 107, 3133, 138633, 90526, 784, 10173, 236789, 236753, 512, 236789, 497, 607, 2173, 236793, 107, 2021, 600, 9380, 69947, 837, 21049, 586, 935, 1886, 699, 786, 236761, 107, 3133, 18677, 699, 154122, 531, 154122, 3442, 512, 236789, 497, 107, 114498, 614, 784, 236772, 82403, 30720, 532, 129859, 1933, 30450, 236761, 107, 236806, 236764, 600, 611, 964, 5869, 236888, 840, 236764, 2765, 236764, 611, 659, 107, 3771, 4890, 23149, 1082, 611, 5869, 1590, 3892, 236787, 107, 3133, 822, 9380, 178837, 531, 1070, 1032, 2583, 236761, 107, 2021, 2352, 822, 1719, 529, 10974, 531, 61862, 1178, 3446, 236793, 107, 2805, 594, 12544, 1363, 7278, 48636, 236764, 3217, 24873, 35627, 8559, 107, 40253, 53243, 5724, 77270, 914, 9899, 2036, 236764, 107, 9520, 236888, 528, 506, 9170, 1056, 506, 86372, 2214, 107, 6372, 20808, 236789, 236751, 2634, 528, 672, 7186, 58664, 694, 231825, 236761, 106, 107, 105, 4368, 107], prompt_embeds shape: None, lora_request: None, prompt_adapter_request: None.
INFO 09-15 16:12:27 [logger.py:43] Received request cmpl-8d50dfbf18ae45fcbaf32e44aa114d80-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nHow far I toil, still farther off from thee.\nBut beauty's waste hath in the world an end,\nDevouring Time, blunt thou the lion's paws,\nWhen in eternal lines to time thou growest:\nWishing me like to one more rich in hope,\nWith shifting change, as is false women's fashion;\nPresume not on thy heart when mine is slain;\nFor through the painter must you see his skill,\nAnd kept unused, the user so destroys it.\nNow is the time that face should form another;\nTo thee I send this written embassage,\nFind no determination: then you were\nAll losses are restored and sorrows end.\nExcusing thy sins more than thy sins are;\nIn thy soul's thought, all naked, will bestow it;\nA dearer birth than this his love had brought,\nAnd see thy blood warm when thou feel'st it cold.\nAnd shalt by fortune once more re-survey\nFrom sullen earth, sings hymns at heaven's gate;\nDesiring this man's art and that man's scope,\nAnd your sweet semblance to some other give.\nThou that art now the world's fresh ornament\nMake glad and sorry seasons as thou fleets,\nAnd by addition me of thee defeated,\nFor no man well of such a salve can speak\nNeither in inward worth nor outward fair,\nNor draw no lines there with thine antique pen;\nShe carved thee for her seal, and meant thereby\nFull many a glorious morning have I seen<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 3910, 2793, 564, 141001, 236764, 2036, 41691, 1135, 699, 44543, 236761, 107, 4573, 9899, 236789, 236751, 8321, 46440, 528, 506, 1902, 614, 1345, 236764, 107, 11062, 114833, 7578, 236764, 63696, 35627, 506, 32329, 236789, 236751, 114386, 236764, 107, 442