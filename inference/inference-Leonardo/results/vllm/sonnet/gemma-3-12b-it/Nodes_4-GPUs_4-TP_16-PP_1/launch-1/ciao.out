INFO 09-15 16:13:56 [logger.py:43] Received request cmpl-15201255b26747d0ad72c9db67cd8037-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nBut wherefore do not you a mightier way\nWhen in eternal lines to time thou growest:\nAnd dumb presagers of my speaking breast,\nTill Nature, as she wrought thee, fell a-doting,\nWhere I may not remove nor be removed.\nShe carved thee for her seal, and meant thereby\nWho for thyself art so unprovident.\nSo I, made lame by fortune's dearest spite,\nSuch civil war is in my love and hate\nDo in consent shake hands to torture me;\nFor whether beauty, birth, or wealth, or wit,\nThat I in thy abundance am sufficed\nAs fast as thou shalt wane, so fast thou growest\nAgainst the stormy gusts of winter's day\nRoses have thorns, and silver fountains mud;\nLooking on darkness which the blind do see\nOr ten times happier, be it ten for one;\nI sigh the lack of many a thing I sought,\nWhy lovest thou that which thou receivest not gladly,\nMark how one string, sweet husband to another,\nAnd dumb presagers of my speaking breast,\nResembling sire and child and happy mother\nHolds in perfection but a little moment,\nLo! in the orient when the gracious light\nIn thy soul's thought, all naked, will bestow it;\nWho plead for love and look for recompense\nThat heals the wound and cures not the disgrace:\nSo great a sum of sums, yet canst not live?\nEntitled in thy parts do crowned sit,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 4573, 1298, 1321, 776, 711, 611, 496, 2473, 1099, 1595, 107, 4420, 528, 37187, 4463, 531, 990, 35627, 2171, 598, 236787, 107, 3133, 31817, 1278, 18773, 529, 1041, 12259, 16489, 236764, 107, 112222, 15007, 236764, 618, 1304, 82326, 44543, 236764, 11561, 496, 236772, 8465, 522, 236764