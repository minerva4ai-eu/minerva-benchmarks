INFO 09-15 16:14:43 [logger.py:43] Received request cmpl-0a58fbc4019f4377bce115524197f89c-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nBut things removed that hidden in thee lie!\nTo him that bears the strong offence's cross.\nNor can I fortune to brief minutes tell,\nAgainst the stormy gusts of winter's day\nCheered and cheque'd even by the self-same sky,\nThen let not winter's ragged hand deface\nWho lets so fair a house fall to decay,\nUpon thyself thy beauty's legacy?\nAnd summer's green all girded up in sheaves\nSweets with sweets war not, joy delights in joy.\nWhy didst thou promise such a beauteous day,\nBy children's eyes her husband's shape in mind.\nShe carved thee for her seal, and meant thereby\nOf public honour and proud titles boast,\nShall sum my count and make my old excuse,'\nBut do not so; I love thee in such sort\nThat thou no form of thee hast left behind,\nAnd 'gainst myself a lawful plea commence:\nFROM fairest creatures we desire increase,\nAnd summer's lease hath all too short a date:\nAs those gold candles fix'd in heaven's air:\nThe world will wail thee, like a makeless wife;\nMay make seem bare, in wanting words to show it,\nThou art thy mother's glass, and she in thee\nFor no man well of such a salve can speak\nWithin thine own bud buriest thy content\nWhen sparkling stars twire not thou gild'st the even.\nBut that I hope some good conceit of thine\nWhy lovest thou that which thou receivest not gladly,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 4573, 2432, 8476, 600, 11497, 528, 44543, 7089, 236888, 107, 2021, 1515, 600, 29402, 506, 3188, 39906, 236789, 236751, 4071, 236761, 107, 31777, 740, 564, 31252, 531, 8652, 4310, 3442, 236764, 107, 91561, 506, 89373, 186031, 529, 7208, 236789, 23675