INFO 09-15 16:10:48 [logger.py:43] Received request cmpl-3512ab345d5e48e0912b1cd3f51b0382-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nTo say, within thine own deep-sunken eyes,\nThen being ask'd where all thy beauty lies,\nBut from thine eyes my knowledge I derive,\nNor draw no lines there with thine antique pen;\nBut wherefore do not you a mightier way\nIntend a zealous pilgrimage to thee,\nAnd see thy blood warm when thou feel'st it cold.\nBy unions married, do offend thine ear,\nThey draw but what they see, know not the heart.\nEntitled in thy parts do crowned sit,\nAnd for a woman wert thou first created;\nThy bosom is endeared with all hearts,\nNow stand you on the top of happy hours,\nTo witness duty, not to show my wit:\nFor whether beauty, birth, or wealth, or wit,\nSo then I am not lame, poor, nor despised,\nNor lose possession of that fair thou owest;\nReserve them for my love, not for their rhyme,\nNor can I fortune to brief minutes tell,\nDie single, and thine image dies with thee.\nO, change thy thought, that I may change my mind!\nAnd in fresh numbers number all your graces,\nThough in our lives a separable spite,\nWhen I consider every thing that grows\nAnd that unfair which fairly doth excel:\nWho with his fear is put besides his part,\nWhat acceptable audit canst thou leave?\nThat 'gainst thyself thou stick'st not to conspire.\nAll losses are restored and sorrows end.<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 2021, 1879, 236764, 2351, 162531, 1852, 5268, 236772, 16283, 3146, 6114, 236764, 107, 11407, 1646, 2679, 236789, 236753, 1298, 784, 21820, 9899, 12828, 236764, 107, 4573, 699, 162531, 6114, 1041, 4654, 564, 27119, 236764, 107, 31777, 4988, 951, 4463, 993, 607, 162531, 34323, 4306, 236793, 107,