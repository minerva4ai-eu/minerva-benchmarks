INFO 09-15 16:10:27 [logger.py:43] Received request cmpl-5d4ca19ded024fa79b5a4e4fa1b33149-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nAs a decrepit father takes delight\nThe dear repose for limbs with travel tired;\nA man in hue, all 'hues' in his controlling,\nI may not evermore acknowledge thee,\nWere an all-eating shame and thriftless praise.\nNow see what good turns eyes for eyes have done:\nSo I, for fear of trust, forget to say\nFind no determination: then you were\nDelights to peep, to gaze therein on thee;\nTo let base clouds o'ertake me in my way,\nThat then I scorn to change my state with kings.\nProfitless usurer, why dost thou use\nYet him for this my love no whit disdaineth;\nOr say with princes if it shall go well,\nThose hours, that with gentle work did frame\nNot from the stars do I my judgment pluck;\nAs a decrepit father takes delight\nMaking a couplement of proud compare,\nBearing thy heart, which I will keep so chary\nAnd night doth nightly make grief's strength seem stronger.\nThy adverse party is thy advocate--\nLeese but their show; their substance still lives sweet.\nAttending on his golden pilgrimage;\nAnd having climb'd the steep-up heavenly hill,\nHis tender heir might bear his memory:\nSo flatter I the swart-complexion'd night,\nOr who is he so fond will be the tomb\nTo work my mind, when body's work's expired:\nMine eyes have drawn thy shape, and thine for me<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 2205, 496, 5161, 21824, 6353, 4716, 14933, 107, 818, 23348, 105125, 573, 50917, 607, 4301, 20718, 236793, 107, 236776, 880, 528, 37766, 236764, 784, 756, 236754, 1303, 236789, 528, 914, 23689, 236764, 107, 236777, 1149, 711, 3785, 5576, 27517, 44543, 236764, 107, 114498, 614, 784, 236772, 8