INFO 09-15 16:13:19 [logger.py:43] Received request cmpl-130e1a33f3a648fd81e56ea6400fc44c-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nAn eye more bright than theirs, less false in rolling,\nMaking a couplement of proud compare,\nAll losses are restored and sorrows end.\nI summon up remembrance of things past,\nFor through the painter must you see his skill,\nAnd all in war with Time for love of you,\nWhose fresh repair if now thou not renewest,\nAnd yet methinks I have astronomy,\nWhen that churl Death my bones with dust shall cover,\nAnd you must live, drawn by your own sweet skill.\nThen can I grieve at grievances foregone,\nFor to thy sensual fault I bring in sense--\nBut that thou none lovest is most evident;\nTheirs for their style I'll read, his for his love.'\nTo show me worthy of thy sweet respect:\nNor lose possession of that fair thou owest;\nThe offender's sorrow lends but weak relief\nIf thou couldst answer 'This fair child of mine\nYet in these thoughts myself almost despising,\nAnd in mine own love's strength seem to decay,\nFor having traffic with thyself alone,\nHolds in perfection but a little moment,\nBut do not so; I love thee in such sort\nO, therefore, love, be of thyself so wary\nWhen I perceive that men as plants increase,\nDisdains the tillage of thy husbandry?\nBeauty's effect with beauty were bereft,\nWith ugly rack on his celestial face,\nMake thee another self, for love of me,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 2267, 7068, 919, 7804, 1082, 61877, 236764, 2344, 2416, 528, 19519, 236764, 107, 41950, 496, 2871, 3326, 529, 11307, 10769, 236764, 107, 3243, 14672, 659, 28251, 532, 179452, 1345, 236761, 107, 236777, 45041, 872, 103209, 529, 2432, 3068, 236764, 107, 2542, 1343, 506, 42289