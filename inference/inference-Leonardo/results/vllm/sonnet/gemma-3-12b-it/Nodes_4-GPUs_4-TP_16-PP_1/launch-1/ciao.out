INFO 09-15 16:14:32 [logger.py:43] Received request cmpl-cd93c4f9880b4283b3874670f7957b5a-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nHiding thy bravery in their rotten smoke?\nNot from the stars do I my judgment pluck;\nReserve them for my love, not for their rhyme,\nSo shall those blots that do with me remain\nWhy didst thou promise such a beauteous day,\nAnd see the brave day sunk in hideous night;\nAttending on his golden pilgrimage;\nFor having traffic with thyself alone,\nAgainst the stormy gusts of winter's day\nFor no man well of such a salve can speak\nWho heaven itself for ornament doth use\nBut that thou none lovest is most evident;\nHow far I toil, still farther off from thee.\nHow much more praise deserved thy beauty's use,\nSo should that beauty which you hold in lease\nAh! but those tears are pearl which thy love sheds,\nOr to thyself at least kind-hearted prove:\nI all alone beweep my outcast state\nFor through the painter must you see his skill,\nWhich in thy breast doth live, as thine in me:\nThat then I scorn to change my state with kings.\nAs I, not for myself, but for thee will;\nThat thou among the wastes of time must go,\nAgainst the stormy gusts of winter's day\nSap cheque'd with frost and lusty leaves quite gone,\nAnd look upon myself and curse my fate,\nWhen forty winters shall beseige thy brow,\nWhose speechless song, being many, seeming one,\nSeeking that beauteous roof to ruinate<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 236814, 3651, 21820, 101666, 528, 910, 91580, 16947, 236881, 107, 4348, 699, 506, 8197, 776, 564, 1041, 11179, 179196, 236793, 107, 133422, 1091, 573, 1041, 2765, 236764, 711, 573, 910, 117370, 236764, 107, 4324, 2863, 1724, 158089, 600, 776, 607, 786, 4595, 107, 11355,