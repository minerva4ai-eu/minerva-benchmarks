INFO 09-15 16:12:17 [logger.py:43] Received request cmpl-4d74a49def0a4f5587eaad780b0cb533-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nAnd heavily from woe to woe tell o'er\nAnd moan the expense of many a vanish'd sight:\nIntend a zealous pilgrimage to thee,\nAnd summer's green all girded up in sheaves\nTo that sweet thief which sourly robs from me.\nO, let my books be then the eloquence\nAnd see thy blood warm when thou feel'st it cold.\nAnd that fresh blood which youngly thou bestowest\nMake glad and sorry seasons as thou fleets,\nHow much more praise deserved thy beauty's use,\nTo let base clouds o'ertake me in my way,\nSo should the lines of life that life repair,\nAnd for a woman wert thou first created;\nWhen forty winters shall beseige thy brow,\nSeeking that beauteous roof to ruinate\nBy oft predict that I in heaven find:\nIs but the seemly raiment of my heart,\nMy love shall in my verse ever live young.\nTo thee I send this written embassage,\nBut when from highmost pitch, with weary car,\nAn eye more bright than theirs, less false in rolling,\nCheered and cheque'd even by the self-same sky,\nThe perfect ceremony of love's rite,\nFor thee and for myself no quiet find.\nWhich husbandry in honour might uphold\nOr say with princes if it shall go well,\nAs any mother's child, though not so bright\nThou art the grave where buried love doth live,\nThy beauty's form in table of my heart;<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 3133, 18677, 699, 154122, 531, 154122, 3442, 512, 236789, 497, 107, 3133, 229308, 506, 18766, 529, 1551, 496, 62911, 236789, 236753, 14186, 236787, 107, 3898, 643, 496, 190303, 88762, 531, 44543, 236764, 107, 3133, 5312, 236789, 236751, 3826, 784, 90114, 524, 872, 528, 156755, 107, 2021, 6