INFO 09-15 16:12:27 [logger.py:43] Received request cmpl-24b9d1330dab4a1189a0b7f0c638913f-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nAnd your true rights be term'd a poet's rage\nAnd in themselves their pride lies buried,\nIs from the book of honour razed quite,\nAnd there reigns love and all love's loving parts,\nWith all triumphant splendor on my brow;\nNo more be grieved at that which thou hast done:\nThen can I drown an eye, unused to flow,\nWhen your sweet issue your sweet form should bear.\nIn one of thine, from that which thou departest;\nWhy didst thou promise such a beauteous day,\nThe bounteous largess given thee to give?\nSets you most rich in youth before my sight,\nHim in thy course untainted do allow\nBut thy eternal summer shall not fade\nSo long as youth and thou are of one date;\nAnd loathsome canker lives in sweetest bud.\nSo thou through windows of thine age shall see\nBeauty o'ersnow'd and bareness every where:\nShall hate be fairer lodged than gentle love?\nI make my love engrafted to this store:\nWhose strength's abundance weakens his own heart.\nThat then I scorn to change my state with kings.\nLike to the lark at break of day arising\nThat heaven's air in this huge rondure hems.\nHath dear religious love stol'n from mine eye\nSo long as youth and thou are of one date;\nWith sun and moon, with earth and sea's rich gems,\nHow much more praise deserved thy beauty's use,\nAgainst this coming end you should prepare,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 3133, 822, 1847, 5726, 577, 1941, 236789, 236753, 496, 27148, 236789, 236751, 49064, 107, 3133, 528, 5507, 910, 21077, 12828, 29051, 236764, 107, 4602, 699, 506, 2260, 529, 20488, 1459, 8562, 4346, 236764, 107, 3133, 993, 128298, 2765, 532, 7