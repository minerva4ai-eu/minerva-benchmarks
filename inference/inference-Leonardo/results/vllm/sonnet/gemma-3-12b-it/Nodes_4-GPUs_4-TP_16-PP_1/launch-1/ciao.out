INFO 09-15 16:09:03 [logger.py:43] Received request cmpl-0e4db8b7ba734bb4a184f5b89e606199-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nHow can I then return in happy plight,\nAnd every fair from fair sometime declines,\nAnd being frank she lends to those are free.\nLike feeble age, he reeleth from the day,\nThat due of many now is thine alone:\nO, then vouchsafe me but this loving thought:\nAnd your sweet semblance to some other give.\nIs it for fear to wet a widow's eye\nWith April's first-born flowers, and all things rare\nSeeking that beauteous roof to ruinate\nHolds in perfection but a little moment,\nAn eye more bright than theirs, less false in rolling,\nBut day by night, and night by day, oppress'd?\nAuthorizing thy trespass with compare,\nSometime too hot the eye of heaven shines,\nUnless thou take that honour from thy name:\nWill be a tatter'd weed, of small worth held:\nThe painful warrior famoused for fight,\nSave breed, to brave him when he takes thee hence.\nWith beauty's treasure, ere it be self-kill'd.\nAnd by addition me of thee defeated,\nBut were some child of yours alive that time,\nThey do but sweetly chide thee, who confounds\nPoints on me graciously with fair aspect\nAnd, tender churl, makest waste in niggarding.\nBe not self-will'd, for thou art much too fair\nI make my love engrafted to this store:\nWill play the tyrants to the very same\nWith sun and moon, with earth and sea's rich gems,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 3910, 740, 564, 1299, 994, 528, 5293, 98080, 236764, 107, 3133, 1418, 5888, 699, 5888, 46232, 61085, 236764, 107, 3133, 1646, 34076, 1304, 89091, 531, 1724, 659, 2196, 236761, 107, 17729, 105868, 3911, 236764, 668, 544, 7159, 594, 699, 506, 1719, 236764, 107, 6372, 2