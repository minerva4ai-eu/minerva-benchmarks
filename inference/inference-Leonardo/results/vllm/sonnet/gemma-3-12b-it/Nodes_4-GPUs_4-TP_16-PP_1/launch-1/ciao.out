INFO 09-15 16:14:08 [logger.py:43] Received request cmpl-826289f1e9f443dd800696458e4f421b-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nLooking on darkness which the blind do see\nAnd nothing 'gainst Time's scythe can make defence\nAh! but those tears are pearl which thy love sheds,\nFor then my thoughts, from far where I abide,\nGreat princes' favourites their fair leaves spread\nWhich husbandry in honour might uphold\nTo thee I send this written embassage,\nWhose strength's abundance weakens his own heart.\nWhich hides your life and shows not half your parts.\nO' let me, true in love, but truly write,\nAnd from the forlorn world his visage hide,\nIf it were fill'd with your most high deserts?\nFind no determination: then you were\nAnd in themselves their pride lies buried,\nProfitless usurer, why dost thou use\nCompare them with the bettering of the time,\nTo let base clouds o'ertake me in my way,\nBut then begins a journey in my head,\nKissing with golden face the meadows green,\nDesiring this man's art and that man's scope,\nOr else receivest with pleasure thine annoy?\nAre windows to my breast, where-through the sun\nAnd every fair with his fair doth rehearse\nLo! thus, by day my limbs, by night my mind,\nBe scorn'd like old men of less truth than tongue,\nYet in these thoughts myself almost despising,\nAnd yet methinks I have astronomy,\nyet mortal looks adore his beauty still,\nThen being ask'd where all thy beauty lies,<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 30988, 580, 29151, 837, 506, 18261, 776, 1460, 107, 3133, 5017, 756, 51775, 540, 7578, 236789, 236751, 1060, 134794, 740, 1386, 25603, 107, 24019, 236888, 840, 1724, 24947, 659, 48361, 837, 21820, 2765, 87719, 236764, 107, 2542, 1299, 1041, 12018, 2367