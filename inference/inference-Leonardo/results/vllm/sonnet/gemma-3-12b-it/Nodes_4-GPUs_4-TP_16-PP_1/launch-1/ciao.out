INFO 09-15 16:14:20 [logger.py:43] Received request cmpl-8afa43c30fdb48c1a11d8115229d37df-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nAnd summer's lease hath all too short a date:\nBut if thou live, remember'd not to be,\nNor shall Death brag thou wander'st in his shade,\nAnd make the earth devour her own sweet brood;\nWith ugly rack on his celestial face,\nFROM fairest creatures we desire increase,\nAnd each, though enemies to either's reign,\nThat 'gainst thyself thou stick'st not to conspire.\nBeauty's effect with beauty were bereft,\nIn thee thy summer, ere thou be distill'd:\nyet mortal looks adore his beauty still,\nDespite of wrinkles this thy golden time.\nSometime too hot the eye of heaven shines,\nHarsh featureless and rude, barrenly perish:\nBorne on the bier with white and bristly beard,\nAnd perspective it is the painter's art.\nLo! thus, by day my limbs, by night my mind,\nI will not praise that purpose not to sell.\nIn singleness the parts that thou shouldst bear.\nThou of thyself thy sweet self dost deceive.\nHath dear religious love stol'n from mine eye\nThat I in thy abundance am sufficed\nBut beauty's waste hath in the world an end,\nThou gavest me thine, not to give back again.\nOr who is he so fond will be the tomb\nNature's bequest gives nothing but doth lend,\nThy unused beauty must be tomb'd with thee,\nHow far I toil, still farther off from thee.\nBut day by night, and night by day, oppress'd?<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 3133, 5312, 236789, 236751, 20850, 46440, 784, 2311, 2822, 496, 3433, 236787, 107, 4573, 768, 35627, 3892, 236764, 5630, 236789, 236753, 711, 531, 577, 236764, 107, 31777, 2863, 20451, 91932, 35627, 52659, 236789, 540, 528, 914, 23791, 236764, 107, 3133, 1386,