INFO 09-15 16:14:31 [logger.py:43] Received request cmpl-cc514f196c6145b2b8ac03cbda7fe4e5-0: prompt: "<bos><start_of_turn>user\nPick as many lines as you can from these poem lines:\nFROM fairest creatures we desire increase,\nThat thereby beauty's rose might never die,\nBut as the riper should by time decease,\nHis tender heir might bear his memory:\nBut thou, contracted to thine own bright eyes,\nFeed'st thy light'st flame with self-substantial fuel,\nMaking a famine where abundance lies,\nThyself thy foe, to thy sweet self too cruel.\nThou that art now the world's fresh ornament\nAnd only herald to the gaudy spring,\nWithin thine own bud buriest thy content\nAnd, tender churl, makest waste in niggarding.\nPity the world, or else this glutton be,\nTo eat the world's due, by the grave and thee.\nWhen I consider every thing that grows\nProving his beauty by succession thine!\nAs those gold candles fix'd in heaven's air:\nO, that you were yourself! but, love, you are\nWithin thine own bud buriest thy content\nAnd you must live, drawn by your own sweet skill.\nBeauty's effect with beauty were bereft,\nAs I, not for myself, but for thee will;\nYou should live twice; in it and in my rhyme.\nBut if the while I think on thee, dear friend,\nEntitled in thy parts do crowned sit,\nWith virtuous wish would bear your living flowers,\nThough thou repent, yet I have still the loss:\nFor whether beauty, birth, or wealth, or wit,\nYet, do thy worst, old Time: despite thy wrong,\nOr say with princes if it shall go well,\nMine be thy love and thy love's use their treasure.\nAs a decrepit father takes delight\nIs it for fear to wet a widow's eye\nWho lets so fair a house fall to decay,\nPity the world, or else this glutton be,\nHiding thy bravery in their rotten smoke?\nDevouring Time, blunt thou the lion's paws,\nThat's for thyself to breed another thee,\nWhen that churl Death my bones with dust shall cover,\nAnd make the earth devour her own sweet brood;\nThat I in thy abundance am sufficed\nWhich to repair should be thy chief desire.\nThen let not winter's ragged hand deface<end_of_turn>\n<start_of_turn>model\n", params: SamplingParams(n=1, presence_penalty=0.0, frequency_penalty=0.0, repetition_penalty=1.0, temperature=0.0, top_p=1.0, top_k=0, min_p=0.0, seed=None, stop=[], stop_token_ids=[], bad_words=[], include_stop_str_in_output=False, ignore_eos=False, max_tokens=150, min_tokens=0, logprobs=None, prompt_logprobs=None, skip_special_tokens=True, spaces_between_special_tokens=True, truncate_prompt_tokens=None, guided_decoding=None, extra_args=None), prompt_token_ids: [2, 2, 105, 2364, 107, 42407, 618, 1551, 4463, 618, 611, 740, 699, 1239, 27355, 4463, 236787, 107, 28337, 12221, 540, 28682, 692, 12614, 3553, 236764, 107, 6372, 17534, 9899, 236789, 236751, 11076, 2473, 2752, 1778, 236764, 107, 4573, 618, 506, 3382, 721, 1374, 684, 990, 20401, 781, 236764, 107, 15989, 21870, 49967, 2473, 10591, 914, 6571, 236787, 107, 4573, 35627, 236764, 45987, 531, 162531, 1852, 7804, 6114, 236764, 107, 28923, 236789, 540, 21820, 2214, 236789, 540, 27400, 607, 1265, 236772, 189395, 7611, 236764, 107, 41950, 496, 93263, 1298, 26444, 12828, 236764, 107, 1214, 986, 883, 21820, 95521, 236764, 531, 21820, 9380, 1265, 2311, 34381, 236761, 107, 178651, 600, 1610, 1492, 506, 1902, 236789, 236751, 5756, 20794, 107, 3133, 1186, 81319, 531, 506, 11557, 66632, 6247, 236764, 107, 43794, 162531, 1852, 5207, 5717, 15163, 21820, 3004, 107, 3133, 236764, 21870, 677, 2451, 236764, 17216, 598, 8321, 528, 116063, 23485, 236761, 107, 236791, 665, 506, 1902, 236764, 653, 1663, 672, 2112, 1654, 577, 236764, 107, 2021, 9039, 506, 1902, 236789, 236751, 2779, 236764, 684, 506, 23674, 532, 44543, 236761, 107, 4420, 564, 1966, 1418, 3210, 600, 23897, 107, 1489, 1965, 914, 9899, 684, 38997, 162531, 236888, 107, 2205, 1724, 5122, 38640, 7562, 236789, 236753, 528, 20808, 236789, 236751, 2634, 236787, 107, 236806, 236764, 600, 611, 964, 5869, 236888, 840, 236764, 2765, 236764, 611, 659, 1