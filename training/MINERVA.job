#!/bin/bash

#SBATCH -J minerva_train

# ##############################################################################
#                                  Overview

# This job defines a launch submission setup using GNU parallel (a powerful 
# tool for executing a command with arguments formed from combinatoric lists). 
# In this case, the command is the worker script, which checks the arguments
# and submits a job step.

# The Slurm SBATCH parameters are intentional. For example, the flag
# `--cpus-per-task` sets `SLURM_CPUS_PER_TASK`, which is is used in the  case 
# of `parallelism="none"` (single GPU) to submit the part-node worker. 
# Another important flag is `--ntasks-per-node`` so that multiple part-node 
# steps can be executed in parallel.

# This job script can be used with main.sh for a CLI submission. For MINERVA,
# each cluster-specific configuration can be handled in a `CONFIG_NAME.job`
# job script, defining it's own task submission (e.g. serial or parallel), 
# file-reading, logging, and environment setup (e.g. container vs native).

# ##############################################################################

# ##############################################################################
#                            Environment Setup
# ##############################################################################


export TORCH_LOGS="recompiles"

source "scripts/shared/runtime_environment.sh"
PYTHON=$(get_cli_python)
echo "PYTHON: $PYTHON"

echo MINERVA_WORKDIR="$MINERVA_WORKDIR"
echo ""

# exit 0
export LOG_DIR="outputs/logs/bashwork/$SLURM_JOB_ID"
if [[ ! -d $LOG_DIR ]]; then
    mkdir -p "$LOG_DIR"
fi

echo "LOG_DIR: $LOG_DIR"

    
py_to_module() {
    local path="$1"

    # Strip leading ./ if present
    path="${path#./}"

    # Only convert if it ends in .py
    if [[ "$path" == *.py ]]; then
        # Remove .py extension
        path="${path%.py}"
        # Replace path separators with dots
        path="${path//\//.}"
        echo "-m $path"
    else
        echo "$path"
    fi
}

runner_fn () {

    echo Starting runner: ...
    echo Printing env...
    echo "SRUN_SCRIPT: $SRUN_SCRIPT \
TRAIN_SCRIPT: $TRAIN_SCRIPT \
FRAMEWORK: $FRAMEWORK \
PARALLELISM: $PARALLELISM \
NNODES: $NNODES \
EXECUTION_MODE: $EXECUTION_MODE \
SINGULARITY_CONTAINER: $SINGULARITY_CONTAINER \
VENV_PATH : $VENV_PATH"
    
    scontrol show step $SLURM_JOB_ID.$SLURM_STEP_ID

    # Check Environment Variables
    echo Config in runner function:
    echo "SLURM_JOB_NUM_NODES: $SLURM_JOB_NUM_NODES" \
    "  SLURM_TASKS_PER_NODE: $SLURM_TASKS_PER_NODE" \
    "  SLURM_NTASKS_PER_NODE: $SLURM_NTASKS_PER_NODE" \
    "  SLURM_STEP_NUM_NODES: $SLURM_STEP_NUM_NODES"  \
    "  SLURM_STEP_NUM_TASKS: $SLURM_STEP_NUM_TASKS"  \
    "  SLURM_STEP_TASKS_PER_NODE: $SLURM_STEP_TASKS_PER_NODE"\
    "  SLURM_GPUS_ON_NODE: $SLURM_GPUS_ON_NODE" \
    "  SLURM_CPUS_ON_NODE: $SLURM_CPUS_ON_NODE" \
    "  SLURM_CPUS_PER_TASK: $SLURM_CPUS_PER_TASK" \
    "  SLURM_NODEID: $SLURM_NODEID" \
    "  SLURM_PROCID: $SLURM_PROCID"

    export TORCHINDUCTOR_CACHE_DIR="$TMPDIR/torchinductor_$USER/$SLURM_JOB_ID.$SLURM_STEP_ID"
    export TENSORBOARD_LOGGING_DIR="$TMPDIR/tensorboard_$SLURM_JOB_ID.$SLURM_STEP_ID"

    # No slurm commands inside the container (only environment variables)
    export HEAD_NODE=$(scontrol show hostnames ${SLURM_STEP_NODELIST} | head -n 1)
    echo HEAD_NODE=$HEAD_NODE

    #export TRAIN_SCRIPT="scripts/$FRAMEWORK-common/finetune-$PARALLELISM.py"

    #bash "$SRUN_SCRIPT" "$YAML_PATH" >> "$LOG_DIR/work-step$SLURM_STEP_ID-task$SLURM_PROCID.log" 2>&1
    # bash scripts/$FRAMEWORK-common/run-$PARALLELISM.sh $1 >> outputs/logs/workers/work-job$SLURM_JOB_ID-step$SLURM_STEP_ID-task$SLURM_PROCID.log 2>&1
    bash "$SRUN_SCRIPT" "$YAML_PATH" 

    echo "Ending runner_fn: `date`"
    echo -e "Finished run: \n\n"
}
export -f runner_fn

IFS=':' read -r -a PATH_ARRAY <<< "$YAMLS"

echo "Received ${#PATH_ARRAY[@]} configurations."

# TODO: refactor config
for YAML_PATH in "${PATH_ARRAY[@]}"; do
    echo here
    echo "$YAML_PATH"

    # build_srun_env() reads env var "YAML_PATH"
    export YAML_PATH
    echo "Setting srun environment..."
    echo "Running: $PYTHON -m scripts.slurm.submitter --build-srun-env"

    export TEMP_ENV_FILE=".tmp_srun_env"
    eval "$PYTHON -m scripts.slurm.submitter --build-srun-env"
    source "$TEMP_ENV_FILE"
    rm "$TEMP_ENV_FILE"

    export TRAIN_SCRIPT=$(py_to_module "$TRAIN_SCRIPT")
    echo "SRUN_SCRIPT: $SRUN_SCRIPT \
TRAIN_SCRIPT: $TRAIN_SCRIPT \
FRAMEWORK: $FRAMEWORK \
PARALLELISM: $PARALLELISM \
NNODES: $NNODES \
EXECUTION_MODE: $EXECUTION_MODE \
SINGULARITY_CONTAINER: $SINGULARITY_CONTAINER \
VENV_PATH : $VENV_PATH"

    
    NGPU=$SLURM_GPUS_ON_NODE
    NCPU=$SLURM_CPUS_ON_NODE
    if [[ $PARALLELISM == "none" ]]; then
        echo heree
        NGPU=1
        NCPU=$SLURM_CPUS_PER_TASK
    fi


    #-c "$NCPU" \
    #    --output=./job_outputs/%j/slurm-%J.out \
    #    --error=./job_outputs/%j/slurm-%J.err \
    srun \
        -N "$NNODES" \
        --ntasks-per-node=1 \
        --gres=gpu:"$NGPU" \
        --export=ALL \
        bash -c "runner_fn $YAML_PATH" &
        
done

# # Use script that calls srun to do checks in order to avoid srun steps with invalid configurations
# parallel -j 0 ./work.sh {} ::: ${model_names[@]} ::: ${frameworks[@]} ::: ${parallelisms[@]} ::: ${node_configs[@]} ::: ${dataset_names[@]} ::: ${batch_sizes[@]} ::: ${grad_accums[@]} ::: ${enable_compile[@]} ::: ${precisions[@]} ::: ${lrs[@]} ::: ${max_lengths[@]} ::: $(seq $trials)
# # parallel -j 0 --joblog joblog.txt ./work.sh $model_name {} ::: ${frameworks[@]} ::: ${parallelisms[@]} ::: $(seq $max_nodes) ::: ${dataset_names[@]} ::: ${batch_sizes[@]} ::: ${grad_accums[@]} ::: ${enable_compile[@]} ::: ${precisions[@]} ::: ${lrs[@]} ::: $(seq $trials)

wait