#!/bin/bash
#SBATCH -A bsc99
#SBATCH -q acc_bench
#SBATCH -N 4
#SBATCH --gres=gpu:4
#SBATCH --ntasks-per-node=4
#SBATCH -c 20
#SBATCH -t 10:00:00

# #SBATCH -D $HOME/minerva-benchmarks/training
#SBATCH -J minerva_train
#SBATCH -o ./job_outputs/%j/slurm-%x.out

# ##############################################################################
#                                  Overview

# This job defines a launch submission setup using GNU parallel (a powerful 
# tool for executing a command with arguments formed from combinatoric lists). 
# In this case, the command is the worker script, which checks the arguments
# and submits a job step.

# The Slurm SBATCH parameters are intentional. For example, the flag
# `--cpus-per-task` sets `SLURM_CPUS_PER_TASK`, which is is used in the  case 
# of `parallelism="none"` (single GPU) to submit the part-node worker. 
# Another important flag is `--ntasks-per-node`` so that multiple part-node 
# steps can be executed in parallel.

# This job script can be used with main.sh for a CLI submission. For MINERVA,
# each cluster-specific configuration can be handled in a `CONFIG_NAME.job`
# job script, defining it's own task submission (e.g. serial or parallel), 
# file-reading, logging, and environment setup (e.g. container vs native).

# ##############################################################################

# ##############################################################################
#                            Environment Setup
# ##############################################################################
module load jq parallel
source config.sh

declare -A paths
paths["gemma3_1b"]="/gpfs/scratch/bsc99/ai_operations/models_registry/models_registry/gemma-3-1b-it"
paths["llama3_8b"]="/gpfs/scratch/bsc99/ai_operations/models_registry/models_registry/Llama-3.1-8B-Instruct"
paths["alpaca"]="/gpfs/scratch/bsc99/ai_operations/minerva_benchmarking/training/training_MN5/datasets/alpaca-cleaned/alpaca_data_cleaned.json"
paths["venv"]="/gpfs/scratch/bsc99/ai_operations/bsc206334/minerva-benchmarks/training/envs/benchmarks/cuda121-flash-attn/.venv"
paths["singularity"]="/gpfs/scratch/bsc99/ai_operations/bsc206334/minerva-benchmarks/training/envs/benchmarks/cuda121-flash-attn/singularity_uv-runtime-ncclIB.sif"
export MINERVAPATHS=$(declare -p paths)
export CONTAINER_ARGS="--nv --network=host"
CONTAINER_ARGS+=" -B `pwd`"
CONTAINER_ARGS+=" -B /gpfs/scratch/bsc99/ai_operations/minerva_benchmarking/training/training_MN5/datasets"
CONTAINER_ARGS+=" -B /gpfs/scratch/bsc99/ai_operations/models_registry/models_registry"
export CONTAINER_PATH=${paths["singularity"]}

export GPU_PEAK_TFLOPS=989

# Defaults (if ran without CLI)
if [[ -z $CONFIG_ENV ]]; then 
    CONFIG_ENV="singularity"
fi
if [[ -z $CONFIGS_PATH ]]; then 
    export CONFIGS_PATH="."
fi
get_config

# TODO: add config
export MAX_MODEL_LENGTH=1024

if [[ -z $OUT_DIR ]]; then 
    export OUT_DIR="results"
fi


if [[ $CONFIG_ENV == "singularity" ]]; then
    module load singularity
else
    module load cuda/12.1 miniforge
    source ${paths["venv"]}/bin/activate
    which python
fi

module list

echo Configuration Data:
echo MINI_MODE=$MINI_MODE
echo CONFIG_DATA=${CONFIG_DATA[@]}
echo CONFIG_ENV=$CONFIG_ENV
echo
echo model_names=${model_names[@]}
echo dataset_names=${dataset_names[@]}
echo node_configs=${node_configs[@]}
echo batch_sizes=${batch_sizes[@]}
echo grad_accums=${grad_accums[@]}
echo enable_compile=${enable_compile[@]}
echo precisions=${precisions[@]}
echo lrs=${lrs[@]}
echo STEPS=$STEPS
echo EPOCHS=$EPOCHS
echo trials=$trials


# Design choice: levels of parallization with rule check

# Rule Check: Model-Framework-Parallelism
for model_name in "${model_names[@]}"; do
    mapfile -t frameworks < <(echo $CONFIG_DATA | jq -r ".models.\"$model_name\".frameworks_supported[]")
    mapfile -t parallelisms < <(echo $CONFIG_DATA | jq -r ".models.\"$model_name\".parallelism_supported[]")

    ncombos=$((${#frameworks[@]} * ${#parallelisms[@]} * ${#node_configs[@]} * ${#dataset_names[@]} * ${#batch_sizes[@]} * ${#grad_accums[@]} * ${#enable_compile[@]} * ${#precisions[@]} * ${#lrs[@]} * $trials))
    echo "Checking $ncombos configurations for model: $model_name"

    # Use script that calls srun to do checks in order to avoid srun steps with invalid configurations
    parallel -j 0 ./work.sh $model_name {} ::: ${frameworks[@]} ::: ${parallelisms[@]} ::: ${node_configs[@]} ::: ${dataset_names[@]} ::: ${batch_sizes[@]} ::: ${grad_accums[@]} ::: ${enable_compile[@]} ::: ${precisions[@]} ::: ${lrs[@]} ::: $(seq $trials)
    # parallel -j 0 --joblog joblog.txt ./work.sh $model_name {} ::: ${frameworks[@]} ::: ${parallelisms[@]} ::: $(seq $max_nodes) ::: ${dataset_names[@]} ::: ${batch_sizes[@]} ::: ${grad_accums[@]} ::: ${enable_compile[@]} ::: ${precisions[@]} ::: ${lrs[@]} ::: $(seq $trials)

done
