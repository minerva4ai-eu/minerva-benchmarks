# =============================================================================
# Singularity Definition File — uv Installation from pyproject.toml
# Usage:
#   singularity build uv_env.sif singularity_uv.def
#   singularity exec uv_env.sif python script.py
#
# Expects: pyproject.toml in the same directory at build time
# =============================================================================


Bootstrap: docker
From: nvidia/cuda:12.1.1-runtime-ubuntu22.04

%labels
    Author          Alexandros Paliouras
    Email           alexandros.paliouras@bsc.es
    Version         1.0.0
    Description     MINERVA training benchmarks python environment built with uv from pyproject.toml
                    Envrironment choice is tailored to MareNostrum5
    InstallMethod   uv

%files
    pyproject.toml /app/uv-env/pyproject.toml
    uv.lock /app/uv-env/uv.lock
%post
    _CWD="/app/uv-env"
    TOML_PATH="$_CWD/pyproject.toml"

    mkdir -p "$_CWD"
    cd "$_CWD"

    echo "==> Installing system dependencies (including curl) in ONE pass..."
    # 1. Install minimal system dependencies
    apt-get update && apt-get install -y --no-install-recommends --allow-change-held-packages \
        python3-pip python3-dev \
        git curl \
        build-essential libnccl2 libnccl-dev \
        cuda-nvcc-12-1

    # 2. install uv env tool
    echo "==> Installing uv via pip..."
    pip install --upgrade pip
    pip install uv
    uv --version

    # Clean up apt cache only at the very end
    rm -rf /var/lib/apt/lists/*

    echo "==> Installing packages from pyproject.toml with uv..."

    # Disable development dependencies
    export UV_PYTHON_INSTALL_DIR=/app/uv-python   # ← not under /root
    export UV_NO_DEV=1
    cd $_CWD
    uv sync --locked


    ln -sf $UV_PYTHON_INSTALL_DIR/cpython-3.11-linux-x86_64-gnu/bin/python3.11 /usr/local/bin/python
    ln -sf $UV_PYTHON_INSTALL_DIR/cpython-3.11-linux-x86_64-gnu/bin/python3.11 /usr/local/bin/python3


    echo "==> Done. Environment installed at /app/uv-env/.venv"

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export UV_SYSTEM_PYTHON=1
    export PATH=/usr/local/cuda/bin:/app/uv-env/.venv/bin:/usr/local/bin:$PATH
    export UV_PROJECT_ENVIRONMENT=/app/uv-env/.venv
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}

%runscript
    exec python "$@"

%test
    echo "--- Python version ---"
    python --version
    echo "--- uv version ---"
    uv --version || echo "(uv not in PATH at runtime; only needed at build time)"
    echo "--- Installed packages ---"
    $UV_PROJECT_ENVIRONMENT/bin/python -c "
import importlib.metadata
dists = sorted(importlib.metadata.distributions(), key=lambda d: d.metadata['Name'])
for d in dists:
    print(d.metadata['Name'], d.metadata['Version'])
"