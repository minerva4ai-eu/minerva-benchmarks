{
  "zero_optimization": {
    "stage": 1
  },
  "optimizer": {
        "type": "AdamW",
        "params": {
            "torch_adam": true,
            "lr": 1e-4,
            "betas": [0.9, 0.95],
            "eps": 1e-8,
            "weight_decay": 0.1
        }
    },

    "scheduler": {
        "type": "WarmupLR",
        "params": {
        "warmup_min_lr": 0.0,
        "warmup_max_lr": 1e-4,
        "warmup_num_steps": 10
        }
    },
    "bf16": {
        "enabled": "auto"
    },
    "fp16": {
        "enabled": "auto"
    },
    "train_micro_batch_size_per_gpu": "auto",
    "gradient_accumulation_steps": "auto"
}