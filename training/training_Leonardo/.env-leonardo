# ENVIRONMENT PATH — relative to this file's directory (update if you recreate the env elsewhere)
ENVIRONMENT_FINETUNING="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/envs/fine-tune-dev"

# External resources — update these 3 paths for your environment
MINIFORGE_PATH=/leonardo_work/cin_staff/dgentile/miniforge3
MODELS_REGISTRY=/leonardo_work/cin_staff/dgentile/models_registry
DATASETS_EXTERNAL=/leonardo_work/MNRVA_bench/datasets
# Internal datasets (auto-computed, no need to change)
DATASETS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/datasets"

# ADDITIONAL VARIABLES
PORT=8000

# Modules to load for activating the environment
# jq is already in /usr/bin on Leonardo, cuda module is available
MODULES="cuda/12.3"

# SUPERCOMPUTER SPECIFIC
SUPCOMPUTER_NAME="Leonardo"
PARTITION_NAME="boost_usr_prod"
ACCOUNT=mnrva_bench
# QOS=boost_qos_dbg
QOS=boost_qos_lprod
GPUS_PER_NODE=4
CPUS_PER_GPU=8
