# =============================================================================
# Singularity Definition File — uv Installation from pyproject.toml
# Usage:
#   singularity build uv_env.sif singularity_uv.def
#   singularity exec uv_env.sif python script.py
#
# Expects: pyproject.toml in the same directory at build time
# =============================================================================


Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

%labels
    Author          Alexandros Paliouras
    Email           alexandros.paliouras@bsc.es
    Version         1.0.0
    Description     MINERVA training benchmarks python environment built with uv from pyproject.toml
                    Envrironment choice is tailored to MareNostrum5
    InstallMethod   uv

%files
    pyproject.toml /opt/uv-env/pyproject.toml
    uv.lock /opt/uv-env/uv.lock
%post
    _CWD="/opt/uv-env"
    UV_INSTALL_SH="$_CWD/uv-install.sh"
    TOML_PATH="$_CWD/pyproject.toml"
    #ENV_PATH="/opt/uv-env/.venv"

    cd "$_CWD"
    
    echo "==> Suppressing apt interactive prompts..."
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC

    echo "==> Installing system dependencies (including curl) in ONE pass..."
    # 1. Install minimal system dependencies
    apt-get update && apt-get install -y --no-install-recommends --allow-change-held-packages \
        python3-pip python3-dev git curl build-essential libnccl2 libnccl-dev


    # 2. install uv env tool
    echo "==> Installing uv via pip..."
    pip install --upgrade pip
    pip install uv
    uv --version

    # Clean up apt cache only at the very end
    rm -rf /var/lib/apt/lists/*

    echo "==> Installing packages from pyproject.toml with uv..."

    # Disable development dependencies
    export UV_NO_DEV=1
    cd /opt/uv-env
    uv sync --locked

    #echo "==> Symlinking python for convenience..."
    ln -sf /opt/uv-env/.venv/bin/python /usr/local/bin/python

    echo "==> Done. Environment installed at /opt/uv-env"

%environment
    #export PATH=/opt/uv-env/.venv/bin:/root/.local/bin:$PATH
    #export VIRTUAL_ENV=/opt/uv-env/.venv
    #export UV_PROJECT_ENVIRONMENT=/opt/uv-env/.venv
    
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export UV_SYSTEM_PYTHON=1
    #export LD_LIBRARY_PATH=/usr/local/cuda-12.4/compat:$LD_LIBRARY_PATH
    #export TRITON_PTXAS_PATH=/usr/local/cuda-12.4/compat/ptxas

%runscript
    #uv -C "$UV_PROJECT_ENVIRONMENT" run python "$@"
    uv run python "@"


%environment
    export UV_PROJECT_ENVIRONMENT=/opt/uv-env/.venv
    export PATH=/usr/local/bin/uv:$PATH

%runscript
    uv -C "$UV_PROJECT_ENVIRONMENT" python "$@"

%test
    echo "--- Python version ---"
    python --version
    echo "--- uv version ---"
    uv --version || echo "(uv not in PATH at runtime; only needed at build time)"
    #echo "--- Installed packages ---"
    #python -m pip list
